+    // SwiftGibs match cues (patch 22): end-of-match banner. State and trigger live in the match
+    // cues section further up (sgendbannertrigger()). Drawn from the post-gui overlay just below,
+    // not from gameplayhud(): gl_drawhud() (engine/rendergl.cpp) runs gameplayhud() BEFORE
+    // g3d_render2d() draws the 2D guis, so a gameplayhud() banner sits under the translucent
+    // intermission scoreboard that showscores(true) opens. Here it sits on top while it fades.
+    // Same visibility gate as gameplayhud() itself (!hidehud && !mainmenu), same centred, scaled,
+    // upper-third idiom as drawflagpopup().
+    void drawendbanner(int w, int h)
+    {
+        if(!sgendbanner || !sgendmillis || hidehud || mainmenu) return;
+        int t = lastmillis - sgendmillis;
+        if(t >= sgendbannertime) { sgendmillis = 0; return; }
+        float fade = 1.0f - float(t)/float(sgendbannertime);
+        int a = int(255*min(1.0f, fade*2.0f));   // full strength for the first half, then fade out
+        static const uchar colours[3][3] = { { 255, 255, 255 }, { 255, 200, 64 }, { 255, 72, 72 } };   // SGEND_NEUTRAL white, SGEND_WIN gold, SGEND_LOSS red
+        const uchar *col = colours[sgendclass];
+        int cx = 1800*w/h/2, cy = 1800/3;
+        int tw, th; text_bounds(sgendtext, tw, th);
+        float scale = min(2.5f, 0.9f*1800*w/h/max(tw, 1));   // a long name shrinks to fit instead of running off the screen
+        pushhudmatrix();
+        hudmatrix.scale(h/1800.0f, h/1800.0f, 1);
+        hudmatrix.translate(cx, cy, 0);
+        hudmatrix.scale(scale, scale, 1);
+        flushhudmatrix();
+        hudshader->set();   // draw_text() binds no shader and the gui pass may end on an untextured one, same as drawstreakfx()
+        draw_text(sgendtext, -tw/2, -th/2, col[0], col[1], col[2], a);
+        pophudmatrix();
+    }
+
