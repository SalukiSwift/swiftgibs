+        // Stub for Task 1: proves input ownership only (doattack() calls here instead of
+        // respawn() while the window is visually active). Real hitscan against the
+        // pooled dummy fpsents and kill accounting arrive in Task 3 (ADR-0003); this only
+        // exercises the squadfirerate cooldown so the VARP is meaningfully wired from day
+        // one rather than sitting inert.
+        if(lastmillis - squadsess.lastfire < squadfirerate) return;
+        squadsess.lastfire = lastmillis;
+    }
