+        // record whether the target went down (kills >= SQUADSIZE, now 1) and why the
+        // session ended, for the end-of-session result line below. A clear recorded here
+        // survives regardless of `reason` - even an external abort right after the kill
+        // still reads as cleared, not as a dangling failure.
+        squadsess.cleared = squadsess.kills >= SQUADSIZE;
+        squadsess.lastreason = reason;
+        squadsess.state = SQUADSTATE_NONE;
