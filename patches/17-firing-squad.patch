+    // === SwiftGibs Reverse Firing Squad (Task 1): squadenter()/squadexit()/
+    // squadupdate()/squadfire() bodies, placed here (not next to the VARPs/struct/
+    // forward-declarations above) because squadenter() needs reloaddemoing()/
+    // hitmarkerdemoing()/streakfxdemoing() (all defined above this point) - same
+    // reason checkautorespawn() itself lives down here. ===
+    void squadenter()
+    {
+        // Close out any still-open previous session first (neutral external abort) so
+        // its outcome is always recorded exactly once even if this fires again without
+        // an explicit squadexit() in between - e.g. edit-mode-toggle-off and un-spectate
+        // both re-enter deathstate()'s d==player1 branch with restore=true (Task 7/8's
+        // own precedent for that same re-entrancy).
+        if(squadsessionopen()) squadexit(SQUADEND_ABORT);
+
+        if(!squad) return;                        // feature toggle off
+        if(!m_mp(gamemode)) return;                // excludes m_dmsp/m_classicsp (M_LOCAL)
+        if(intermission) return;
+        if(player1->state != CS_DEAD) return;      // defence in depth; always true here
+        if(reloaddemoing() || hitmarkerdemoing() || streakfxdemoing()) return;
+
+        int cmodewaitms = cmode ? cmode->respawnwait(player1)*1000 : 0;   // ADR-0002: raw per-mode wait, NOT the RESPAWNREADYFLOOR/spawnwait-padded estimate above
+        squadsess.state = SQUADSTATE_PENDING;
+        squadsess.start = lastmillis + SQUADENTRYBEAT;
+        squadsess.end = lastmillis + max(cmodewaitms, squadwindow);
+        squadsess.kills = 0;
+        squadsess.cleared = false;
+        squadsess.lastfire = -1000000;
+    }
+
+    void squadexit(int reason)
+    {
+        if(squadsess.state == SQUADSTATE_NONE) return;
+        // amendment 3: no ladder/progression to update - just record whether the wave
+        // was fully cleared (kills reached SQUADSIZE) and why the session ended, for
+        // Task 4's end-of-session result line. A clear recorded here survives regardless
+        // of `reason` - even an external abort right after the last kill still reads as
+        // cleared, not as a dangling failure.
+        squadsess.cleared = squadsess.kills >= SQUADSIZE;
+        squadsess.lastreason = reason;
+        squadsess.state = SQUADSTATE_NONE;
+    }
+
+    void squadupdate()
+    {
+        // Unconditional per-frame poll (called from updateworld() above, every frame
+        // regardless of connection/player state). This patch is confined to
+        // fpsgame/fps.cpp (Task 1 scope), so hooking client.cpp's network handlers or
+        // engine/octaedit.cpp's toggleedit() directly for the external-abort triggers is
+        // not an option - polling player1->state instead covers every one of ADR-0002's
+        // triggers exactly: a server-forced spawn, edit-mode entry (-> CS_EDITING) and
+        // spectator entry (-> CS_SPECTATOR) all move state away from CS_DEAD, so a single
+        // `state != CS_DEAD` check catches all three uniformly.
+        if(squadsess.state == SQUADSTATE_NONE) return;
+        if(!connected || intermission || !m_mp(gamemode) || player1->state != CS_DEAD)
+        {
+            squadexit(SQUADEND_ABORT);
+            return;
+        }
+        if(squadsess.state == SQUADSTATE_PENDING && lastmillis >= squadsess.start) squadsess.state = SQUADSTATE_ACTIVE;
+        if(lastmillis >= squadsess.end) squadexit(SQUADEND_TIMEOUT);
+    }
+
