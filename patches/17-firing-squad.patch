+    // "damage" is max(-health,0) = 99) so the gib looks identical to a real frag rather
+    // than an arbitrary number. SQUADRAYLEN matches engine/rendergl.cpp squadview::'s own
+    // farplane (1024) - comfortably past any target within squadtargetdistmax.
+    static const int SQUADGIBDAMAGE = 99;
+    static const float SQUADRAYLEN = 1024.0f;
+    // amendment 7 (playtest 3, IMPACT): tunables for the replicated shot effects - see
+    // squadfire()'s own comment below for the full derivation of each.
+    // amendment 8: SQUADMISSDIST bumped 80->140 to stay past the widened
+    // squadtargetdistmax (110 default, was 60) - the same "a miss never visually
+    // coincides with where the target could have stood" invariant iter3 established,
+    // just re-tuned for the new range.
+    static const float SQUADMISSDIST = 140.0f;     // sensible "the shot vanished here" distance for a miss's impact burst - past squadtargetdistmax (110 default), well short of SQUADRAYLEN/squadview's farplane (1024)
+    static const float SQUADMUZZLEOFFSET = 3.0f;   // synthetic first-person muzzle point: units in front of the eye along the fire direction
+    // amendment 8: running-target speed, matched to a normal player's own movement
+    // rather than a guessed number - derived from engine/physics.cpp's
+    // modifyvelocity(): a player's target ground velocity for pure-forward movement
+    // (move=1, strafe=0, not floating/underwater, on a flat floor) is
+    // `maxspeed * (move && !strafe ? 1.3f : 1.0f)` (the forward-only 1.3x bonus,
+    // physics.cpp), where maxspeed is physent::maxspeed - defaulted to 100 and never
+    // overridden for a real fpsent anywhere in fpsgame/ (shared/ents.h) - so a normal
+    // player's sustained straight-line run speed is 100*1.3 = 130 engine units/second.
+    // No diagonal-move boost applies (the move/strafe direction vector is
+    // normalize()'d before the maxspeed multiply, physics.cpp), so this is exactly the
+    // simple "holding forward" case the amendment asked for, not an inflated number.
+    static const float SQUADRUNSPEED = 130.0f;
+
+    // amendment 8 (playtest 3 follow-up): the running target's live horizontal offset -
+    // a PURE function of session state + lastmillis (no stored/integrated position), so
+    // fpsgame/render.cpp's squadrender() (every rendered frame) and this file's own
+    // squadfire() (the exact instant a shot is fired) always compute the identical
+    // value from the identical formula - there is no "last known position" to go stale
+    // between a render and a shot. A static session (squadtargetmoving false) just
+    // returns the fixed per-session squadtargetx, byte-identical to every prior
+    // iteration. A moving session traces a symmetric triangle wave between
+    // -squadtargetxcap and +squadtargetxcap (the same FOV-scaled cap squadenter()
+    // computed above, so the sweep can never leave the findable cone, not just at its
+    // starting position) beginning at 0 - dead centre, exactly where the player is
+    // already looking the instant the void cuts in, moving or not, so a running session
+    // is just as immediately findable as a stationary one - and turning around at each
+    // end rather than teleporting/wrapping: a wrap would pop the target from one edge of
+    // the screen to the other, which reads as a glitch, not a drill; turning around is
+    // continuous and is how a real player would actually behave in a confined space.
+    float squadcurrentx()
+    {
+        if(!squadtargetmoving || squadtargetxcap <= 0) return squadtargetx;
+        float amp = squadtargetxcap;
+        float t = max(lastmillis - squadsess.start, 0) / 1000.0f;
+        float m = fmodf(SQUADRUNSPEED*t, 4*amp);
+        if(m < 0) m += 4*amp;
+        if(m <= amp) return m;
+        if(m <= 3*amp) return 2*amp - m;
+        return m - 4*amp;
+    }
+
+    // amendment 8: direction of travel at the current instant (+1 toward +right/+x,
+    // -1 toward -right/-x, 0 only when the session isn't moving at all) - the exact same
+    // triangle-wave phase as squadcurrentx() above (both pure functions of the same
+    // lastmillis/session state), so the two can never disagree with each other. Used to
+    // orient the model to face where it's actually going - see fpsgame/render.cpp
+    // squadrender()'s own comment on the yaw math.
+    float squadcurrentdir()
+    {
+        if(!squadtargetmoving || squadtargetxcap <= 0) return 0;
+        float amp = squadtargetxcap;
+        float t = max(lastmillis - squadsess.start, 0) / 1000.0f;
+        float m = fmodf(SQUADRUNSPEED*t, 4*amp);
+        if(m < 0) m += 4*amp;
+        return (m <= amp || m > 3*amp) ? 1.0f : -1.0f;
+    }
