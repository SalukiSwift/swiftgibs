+    // ---- SwiftGibs benchmark mode (patch 22) ----
+    //
+    // sgbench <demofile> plays a demo UNCAPPED (limitfps(), engine/main.cpp, becomes a no-op
+    // while benchmeasuring is set) and times every main-loop iteration with the perf counter -
+    // not the engine's own integer-millisecond clock, which is quantised to whole ms and has its
+    // own delay logic during normal play; it is never the right tool for "how long did this frame
+    // actually take". Reuses the stock demo player entirely (mode -1 + map <file>, same as the
+    // `demo` alias in data/game_fps.cfg) - no new playback code here, only measurement.
+    //
+    // State machine: IDLE (!bencharmed) -> PENDING (bencharmed, !benchmeasuring: armed, waiting
+    // for THIS run's playback to actually start) -> MEASURING (bencharmed, benchmeasuring) ->
+    // back to IDLE once a report or BENCH ERROR fires (which always also quit()s). Driven
+    // entirely by polling the `demoplayback` flag once per frame in benchframe() below, NOT by a
+    // N_DEMOPLAYBACK packet hook - review found two real termination paths that never send that
+    // packet: gamedisconnect() (fpsgame/client.cpp) sets demoplayback=false directly on any
+    // disconnect, reachable via the localdisconnect/disconnect console commands at any time
+    // during local playback; and setupdemoplayback()'s validation-failure branch
+    // (fpsgame/server.cpp - bad magic/version/protocol) prints a message and returns WITHOUT
+    // ever sending N_DEMOPLAYBACK on or off, so demoplayback just never becomes true. Polling
+    // the flag directly catches every one of these the same way it catches the ordinary case, at
+    // most one frame later - ARMED and MEASURING never depend on which code path changed the
+    // flag. PENDING's timeout (BENCHSTARTTIMEOUTMS) is what turns that silent
+    // setupdemoplayback() failure into a reported BENCH ERROR instead of an armed-forever hang.
+    //
+    // This same design also closes a race the packet-hook version had: if a demo is ALREADY
+    // playing when sgbench is invoked, its own "stopdemo; mode -1; map ..." synchronously stops
+    // the OLD demo first (server::stopdemo() -> enddemoplayback() -> sendf() -> local packet
+    // delivery is synchronous, fpsgame/server.cpp/fpsgame/client.cpp) - entirely within the
+    // sgbench ICOMMAND body below, before benchframe() is ever called again. So by the time
+    // PENDING's poll first runs, demoplayback is already false and stays that way (map still
+    // loading) or has already flipped true for the NEW file - either way there's nothing left
+    // to mistake for "the new run already ended".
+    //
+    // Measurement rules (this comment block is the spec, not just a description):
+    // - Timing: SDL_GetPerformanceCounter() delta between consecutive main-loop iterations,
+    //   converted to ms via SDL_GetPerformanceFrequency(). The engine ms clock is never used.
+    // - Window: only frames where demoplayback is true AND at least 2000ms (perf-counter time)
+    //   have passed since playback started are recorded - discards map-load settling. Ticks are
+    //   still tracked every call so the first recorded frame is a genuine single-frame delta, not
+    //   the whole settling window lumped into one sample.
+    // - Storage: a preallocated static float array, capacity BENCHCAP (1,000,000) frames; once
+    //   full, recording stops (benchtruncated) rather than reallocating or crashing.
+    // - p50/p95/p99: sort a COPY of the captured frame times (source array is left untouched);
+    //   p(k) = sorted[min(n-1, (size_t)(k/100.0*n))] - nearest-rank, truncating (not rounding)
+    //   the rank index down.
+    // - 1% low fps: 1000.0 / mean(worst 1% of frame times), worst count = max(1, n/100).
+    // - stutters: frames strictly greater than 2.0 * median (median = the p50 above).
+    // - On demoend: compute, print BENCH: summary lines, append a benchresults.csv row, write
+    //   benchframes-<row>.csv (one ms value per line) if benchdumpframes is 1, then quit().
+    // - On failure (missing file, playback never starts, disconnect before demoend, zero frames
+    //   captured): print "BENCH ERROR: <reason>" and quit() anyway - runners detect success by
+    //   CSV row growth, not by exit code.
+    //
+    // benchmeasuring itself is defined at TRUE FILE SCOPE, above namespace game's opening brace -
+    // see the comment up there for why.
+    static bool bencharmed = false;
+    static Uint64 benchpendingticks = 0;      // SDL_GetPerformanceCounter() at arm time - PENDING's start-timeout clock
+    static Uint64 benchstartticks = 0;        // SDL_GetPerformanceCounter() when demoplayback actually went true
+    static const int BENCHCAP = 1000000;
+    static float *benchframes_ms = NULL;      // allocated once on arm
+    static int benchcount = 0;
+    static bool benchtruncated = false;
+    static Uint64 benchlastticks = 0;
+    static string benchdemofile;              // stashed at arm time - BENCH: lines / CSV "demo" column
+    static const double BENCHSTARTTIMEOUTMS = 10000.0;   // give up waiting for playback to start after this long
+    VAR(benchdumpframes, 0, 1, 1);             // write benchframes-<row>.csv alongside the CSV row (not persisted)
+
+    struct benchstats { float p50, p95, p99, onepctlow, worst; int stutters; };
+
+    // p(k) on an already-sorted array: nearest-rank, truncating (not rounding) the index - the
+    // one formula sgbenchselftest exists to pin down; its expected values were computed by hand
+    // against exactly this convention (see the measurement-rules comment above).
+    static float benchpercentile(const float *sorted, int n, double k)
+    {
+        size_t idx = min(size_t(n-1), size_t(k/100.0*n));
+        return sorted[idx];
+    }
+
+    // Sorts a COPY of src[0..n) (src itself is left untouched) and fills in every stat the
+    // measurement rules define. Shared by benchreport() (a real capture) and sgbenchselftest
+    // (a fixed fixture array) below, so both run through the exact same math.
+    static void benchcomputestats(const float *src, int n, benchstats &out)
+    {
+        float *sorted = new float[n];
+        memcpy(sorted, src, n*sizeof(float));
+        quicksort(sorted, n);
+
+        out.p50 = benchpercentile(sorted, n, 50.0);
+        out.p95 = benchpercentile(sorted, n, 95.0);
+        out.p99 = benchpercentile(sorted, n, 99.0);
+        out.worst = sorted[n-1];
+
+        int worstcount = max(1, n/100);
+        double worstsum = 0;
+        for(int i = 0; i < worstcount; i++) worstsum += sorted[n-1-i];
+        out.onepctlow = float(1000.0 / (worstsum/worstcount));
+
+        int stutters = 0;
+        for(int i = 0; i < n; i++) if(src[i] > 2.0f*out.p50) stutters++;
+        out.stutters = stutters;
+
+        delete[] sorted;
+    }
+
+    static void benchreport();   // forward decl - defined below; benchframe() below is the only caller
+
+    // Called unconditionally from the main loop (engine/main.cpp, right after
+    // getclockmillis()) - a no-op before sgbench arms a run and forever after that run reports.
+    // See the state-machine comment above the state block: this single function drives the
+    // whole PENDING -> MEASURING -> report/error lifecycle by polling demoplayback directly.
+    void benchframe()
