+            // PENDING: a transition to true is unambiguously THIS run's own playback starting
+            // (see the race note above the state block for why a stale/leftover false reading
+            // can never be mistaken for anything here) - anything else just means keep waiting,
+            // up to the timeout.
+            if(demoplayback)
+            {
+                benchmeasuring = true;
+                benchstartticks = now;
+                benchlastticks = 0;
+                return;
+            }
+            double waitedms = double(now - benchpendingticks) * 1000.0 / double(freq);
+            if(waitedms >= BENCHSTARTTIMEOUTMS)
+            {
+                bencharmed = false;
+                conoutf("BENCH ERROR: demo playback never started (missing/corrupt/incompatible file?)");
+                quit();
+            }
+            return;
+        }
+
+        // MEASURING: demoplayback going false here - by ANY means, packet-driven or not - is
+        // this run ending.
+        if(!demoplayback)
+        {
+            bencharmed = false;
+            benchmeasuring = false;
+            if(benchcount) benchreport();
+            else { conoutf("BENCH ERROR: no frames captured"); quit(); }
+            return;
+        }
+
+        double sincestart = double(now - benchstartticks) * 1000.0 / double(freq);
+        if(sincestart >= 2000.0 && benchlastticks)
+        {
+            double deltams = double(now - benchlastticks) * 1000.0 / double(freq);
+            if(benchcount < BENCHCAP) benchframes_ms[benchcount++] = float(deltams);
+            else benchtruncated = true;
+        }
+        benchlastticks = now;
+    }
+
+    // Only ever called with benchcount > 0 (see benchframe() above) - the zero-frames case is
+    // handled entirely by the caller, so this never has to.
+    static void benchreport()
+    {
+        benchstats st;
+        benchcomputestats(benchframes_ms, benchcount, st);
+
+        double totalms = 0;
+        for(int i = 0; i < benchcount; i++) totalms += benchframes_ms[i];
+        double seconds = totalms/1000.0;
+        double avgfps = seconds > 0 ? benchcount/seconds : 0.0;
+
+        conoutf("BENCH: demo=%s frames=%d seconds=%.2f avgfps=%.2f%s", benchdemofile, benchcount, seconds, avgfps, benchtruncated ? " TRUNCATED" : "");
+        conoutf("BENCH: p50=%.2fms p95=%.2fms p99=%.2fms worst=%.2fms", st.p50, st.p95, st.p99, st.worst);
+        conoutf("BENCH: onepctlow=%.2ffps stutters=%d", st.onepctlow, st.stutters);
+
+        const char *fname = "benchresults.csv";
+        bool existed = fileexists(findfile(fname, "r"), "r");   // same idiom as fpsstatswritelog() (fpsgame/fps.cpp)
+        int row = 1;
+        if(existed)
+        {
+            stream *rf = openfile(fname, "r");
+            if(rf)
+            {
+                string linebuf;
+                int lines = 0;
+                while(rf->getline(linebuf, sizeof(linebuf))) lines++;
+                delete rf;
+                row = lines;   // header + N existing data rows already on disk = N+1 lines = this row's number
+            }
+        }
+        stream *o = openfile(fname, "a");
+        if(!o) { conoutf("BENCH ERROR: could not open %s for writing", fname); quit(); return; }
+        if(!existed) o->printf("utc,version,platform,demo,frames,seconds,avgfps,p50ms,p95ms,p99ms,onepctlow_fps,worst_ms,stutters,width,height\n");
+
+        time_t nowt = time(NULL);
+        string utcbuf;
+        strftime(utcbuf, sizeof(utcbuf), "%Y-%m-%dT%H:%M:%SZ", gmtime(&nowt));
+        const char *ver = getalias("swiftgibsversion");
+#ifdef WIN32
+        const char *plat = "windows";
+#elif defined(__APPLE__)
+        const char *plat = "mac";
+#else
+        const char *plat = "linux";
+#endif
+        o->printf("%s,%s,%s,%s,%d,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%d,%d,%d\n",
+                   utcbuf, ver, plat, benchdemofile, benchcount, seconds, avgfps,
+                   st.p50, st.p95, st.p99, st.onepctlow, st.worst, st.stutters, screenw, screenh);
+        delete o;
+
+        if(benchdumpframes)
+        {
+            defformatstring(dumpname, "benchframes-%d.csv", row);
+            stream *df = openfile(dumpname, "w");
+            if(df)
+            {
+                for(int i = 0; i < benchcount; i++) df->printf("%.3f\n", benchframes_ms[i]);
+                delete df;
+            }
+        }
+
+        conoutf("BENCH: done");
+        quit();
+    }
+
+    // Filename supplied to sgbench, stashed at arm time and echoed into the BENCH: lines / CSV
+    // "demo" column; the findfile()/fileexists() check below is the same existence-check idiom
+    // fpsstatswritelog() uses (fpsgame/fps.cpp), not a full replication of setupdemoplayback()'s
+    // own demodir/extension-fallback resolution (fpsgame/server.cpp) - stock playback still does
+    // that part; this is just an early, friendly failure for a typo'd or missing filename.
+    // Order matters here: bencharmed/benchpendingticks are set, and any leftover demo is
