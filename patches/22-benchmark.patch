+        benchstats st;
+        benchcomputestats(benchselftestfixture, 10, st);
+        conoutf("BENCH SELFTEST: n=10 p50=%.2f p95=%.2f p99=%.2f onepctlow=%.2f worst=%.2f stutters=%d",
