+#include "sghttp.h"
+
+// --- SwiftGibs: in-game feedback -> plain-HTTP POST to the feedback relay ---
+// Transport (resolve/connect/send/recv, header + Content-Length parsing) now
+// lives in fpsgame/sghttp.cpp - this is just request assembly and the UI loop
+// (progress bar + esc-to-abort) that drives it. Plaintext on purpose - the
+// engine has no TLS and nothing secret crosses this hop (the GitHub token
+// stays server-side). The POST is multipart/form-data: text fields (feedback
+// + telemetry the engine can see: map, mode, position, fps) plus an optional
+// JPEG screenshot taken by the F8 hotkey (screenshot/feedbackshot.jpg). Match
+// stats arrive as the script-assembled "info" argument (frags/deaths/...
+// commands live in the game dll side, not here).
+
+SVAR(feedbackhost, "salukiswift.com");
+VAR(feedbackport, 1, 8300, 0xFFFF);
+
+// sghttp's timeoutms now covers resolve+connect+send+recv as ONE budget,
+// where the pre-extraction code gave each phase its own window (resolverwait
+// RESOLVERLIMIT 3000 + connectwithtimeout CONNLIMIT 20000 + the old shared
+// send/recv FEEDBACKLIMIT 15000): 3000+20000+15000 = 38000, so the combined
+// budget below matches the old worst-case ceiling instead of shrinking it.
+#define FEEDBACKLIMIT 38000
+#define FEEDBACKBOUNDARY "----SwiftGibsFeedback7d1298fa3e8a"
+
+static void feedbackstatus(const char *msg)
+{
+    alias("feedbackstatus", msg);
+    conoutf("feedback: %s", msg);
+}
+
+// sghttp only reports WHICH phase failed (sghttperrphase(), valid after a 0
+// return), not the finer distinctions the old inline socket code used to
+// make (eg. "could not open a socket" vs "could not reach the feedback
+// server" were both pre-connect failures - now one CONNECT phase). Restores
+// the old message text where the phase still maps 1:1; the rest fold into
+// the closest-fitting original string.
+static const char *feedbackerrmsg(int phase)
+{
+    switch(phase)
+    {
+        case SGHTTP_ERR_RESOLVE: return "could not resolve the feedback server";
+        case SGHTTP_ERR_CONNECT: return "could not reach the feedback server";
+        case SGHTTP_ERR_SEND: return "timed out - try again later";
+        case SGHTTP_ERR_RECV: return "no reply from the feedback server";
+        case SGHTTP_ERR_BADREPLY: return "bad reply from the feedback server";
+        default: return "could not reach the feedback server";
+    }
+}
+
+static void feedbackfield(vector<char> &out, const char *name, const char *value)
+{
+    defformatstring(head, "--" FEEDBACKBOUNDARY "\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n", name);
+    out.put(head, strlen(head));
+    out.put(value, strlen(value));
+    out.put("\r\n", 2);
+}
+
+// Drives sghttppost's progress bar - the one renderprogress/interceptkey loop
+// left in this file. sghttp itself never touches either.
+struct feedbackprogress : sghttpprogress
+{
+    const char *text;
+    feedbackprogress(const char *text) : text(text) {}
+    bool tick(int got, int total)
+    {
+        renderprogress(total > 0 ? float(got)/total : 0.0f, text);
+        return !interceptkey(SDLK_ESCAPE);
+    }
+};
+
+void sendfeedback(const char *name, const char *category, const char *version, const char *text, int shot, const char *info)
+{
+    if(!text[0]) { feedbackstatus("nothing to send"); return; }
+
+    // assemble the multipart body: player fields + engine telemetry
+    vector<char> body;
+    feedbackfield(body, "name", name);
+    feedbackfield(body, "category", category);
+    feedbackfield(body, "version", version);
+#ifdef WIN32
+    feedbackfield(body, "platform", "windows");
+#elif defined(__APPLE__)
+    feedbackfield(body, "platform", "mac");
+#else
+    feedbackfield(body, "platform", "linux");
+#endif
+    feedbackfield(body, "text", text);
+    if(info[0]) feedbackfield(body, "info", info);
+
+    const char *map = game::getclientmap();
+    if(map && map[0]) feedbackfield(body, "map", map);
+    const char *mode = game::getscreenshotinfo();
+    if(mode && mode[0]) feedbackfield(body, "mode", mode);
+    if(camera1)
+    {
+        defformatstring(pos, "%d %d %d", int(camera1->o.x), int(camera1->o.y), int(camera1->o.z));
+        feedbackfield(body, "pos", pos);
+    }
+    int fps = 0, bestdiff = 0, worstdiff = 0;
+    getfps(fps, bestdiff, worstdiff);
+    defformatstring(fpsstr, "%d", fps);
+    feedbackfield(body, "fps", fpsstr);
+
+    if(shot)
+    {
+        extern char *screenshotdir;
+        defformatstring(shotpath, "%s%sfeedbackshot.jpg", screenshotdir, screenshotdir[0] ? "/" : "");
+        size_t shotlen = 0;
+        char *shotdata = loadfile(path(shotpath), &shotlen, false);
+        if(shotdata)
+        {
+            const char *head = "--" FEEDBACKBOUNDARY "\r\nContent-Disposition: form-data; name=\"shot\"; filename=\"feedbackshot.jpg\"\r\nContent-Type: image/jpeg\r\n\r\n";
+            body.put(head, strlen(head));
+            body.put(shotdata, (int)shotlen);
+            body.put("\r\n", 2);
+            delete[] shotdata;
+        }
+        else conoutf("feedback: no screenshot found, sending without it");
+    }
+    body.put("--" FEEDBACKBOUNDARY "--\r\n", strlen("--" FEEDBACKBOUNDARY "--\r\n"));
+
+    defformatstring(progresstext, "sending feedback to %s... (esc to abort)", feedbackhost);
+    feedbackprogress fp(progresstext);
+    renderprogress(0, progresstext);
+
+    vector<uchar> out;
+    int code = sghttppost(feedbackhost, feedbackport, "/feedback", "multipart/form-data; boundary=" FEEDBACKBOUNDARY, body, out, FEEDBACKLIMIT, &fp);
+
+    if(code == -1) { feedbackstatus("aborted"); return; }
+    if(code == 0) { feedbackstatus(feedbackerrmsg(sghttperrphase())); return; }
+
+    out.add('\0');
+    char *msg = (char *)out.getbuf();
+    char *end = strpbrk(msg, "\r\n");
+    if(end) *end = '\0';
+
+    if(code == 200) feedbackstatus(msg[0] ? msg : "sent - thank you!");
+    else if(msg[0] && code >= 400 && code < 500) feedbackstatus(msg);
+    else
+    {
+        defformatstring(err, "feedback server error (%d)", code);
+        feedbackstatus(err);
+    }
+}
+
+ICOMMAND(sendfeedback, "ssssis", (const char *name, const char *category, const char *version, const char *text, int *shot, const char *info), sendfeedback(name, category, version, text, *shot, info));
+
+// --- SwiftGibs: launch-time update check (autoexec: checkupdate $swiftgibsversion) ---
+// Asks the relay for the latest release tag (GET /version - the engine cannot
+// reach GitHub's HTTPS itself). Deliberately SILENT and short-budget: it runs
+// during init, so no progress UI and no error spam - a dead relay or an
+// offline box just means no update banner (passing no sghttpprogress to
+// sghttpget below is what keeps it silent - sghttp never renders on its own).
+// Results land in the aliases swiftgibsupdate (0/1) + swiftgibslatest, which
+// the main-menu gui reads.
+// Same single-budget-covers-everything change as FEEDBACKLIMIT above: old
+// worst case was resolverwait's RESOLVERLIMIT 3000 + this function's own
+// silent one-shot connect wait (2000) + the old shared send/recv
+// CHECKUPDLIMIT 2500 = 7500, so the combined budget below matches that
+// instead of shrinking to the old send/recv-only window.
+#define CHECKUPDLIMIT 7500
+
+static bool parseversion(const char *s, int &major, int &minor, int &patch)
+{
+    if(*s == 'v' || *s == 'V') s++;
+    major = minor = patch = 0;
+    return sscanf(s, "%d.%d.%d", &major, &minor, &patch) >= 2;
+}
+
+void checkupdate(const char *current)
+{
+    alias("swiftgibsupdate", "0");
+    alias("swiftgibslatest", "");
+
+    vector<uchar> out;
+    if(sghttpget(feedbackhost, feedbackport, "/version", out, CHECKUPDLIMIT) != 200) return;
+    out.add('\0');
+
+    char *tag = (char *)out.getbuf();
+    char *end = strpbrk(tag, "\r\n");
+    if(end) *end = '\0';
+
+    int lmaj, lmin, lpat, cmaj, cmin, cpat;
+    if(!parseversion(tag, lmaj, lmin, lpat) || !parseversion(current, cmaj, cmin, cpat)) return;
+    if(lmaj > cmaj || (lmaj == cmaj && (lmin > cmin || (lmin == cmin && lpat > cpat))))
+    {
+        if(*tag == 'v' || *tag == 'V') tag++;
+        alias("swiftgibslatest", tag);
+        alias("swiftgibsupdate", "1");
+        conoutf("\f2SwiftGibs v%s is out (you have v%s) - run update-swiftgibs.bat in the game folder", tag, current);
+    }
+}
+
+ICOMMAND(checkupdate, "s", (const char *current), checkupdate(current));
