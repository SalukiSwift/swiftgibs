+// sghttp.cpp: minimal blocking HTTP/1.1 GET/POST transport over raw enet
+// sockets. Shared by the in-game feedback POST and the launch-time
+// update-check GET (see engine/serverbrowser.cpp) - previously each hand-rolled
+// its own resolve/connect/send/recv loop; this file is the one copy.
+//
+// Transport only: name resolution, socket connect, request framing, response
+// header + Content-Length parsing. Never calls renderprogress/interceptkey or
+// any other renderer/UI function - callers drive their own progress bar and
+// cancel key through the sghttpprogress callback passed in. Nothing in here
+// actually touches SDL/GL either (only enet_* calls, cube's vector<>, and a
+// raw platform thread for DNS - see below), so a -DSTANDALONE build (same
+// flag the dedicated server already uses) links this file with just enet +
+// zlib, no SDL/GL/X11 needed.
+//
+// The DNS-resolve job below uses GCC/Clang's __atomic_* builtins rather than
+// <atomic> - <atomic> transitively includes <new>, which conflicts with
+// shared/tools.h's own hand-rolled placement-new operators (a hard
+// "redefinition" compile error the moment both are in one translation unit).
+// The builtins need no header at all and work identically here.
+
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <enet/enet.h>
+#ifndef WIN32
+#include <pthread.h>
+#endif
+#include "sghttp.h"
+
+// Last failure phase, per calling thread - see sghttp.h for the contract.
+// __thread, not C++11 thread_local: the vendor Makefile sets no -std=, and
+// Apple Clang's flagless default dialect lacks thread_local under that
+// setup; __thread is a GCC/Clang storage-class extension that works for a
+// plain int on Linux g++, mingw-w64 g++, and Apple Clang alike, with no
+// C++11 requirement.
+static __thread int sghttplasterr = SGHTTP_ERR_NONE;
+
+int sghttperrphase() { return sghttplasterr; }
+
+#ifdef WIN32
+static void sghttpsleepms(int ms) { if(ms > 0) Sleep(ms); }
+#else
+static void sghttpsleepms(int ms)
+{
+    if(ms <= 0) return;
+    struct timespec ts;
+    ts.tv_sec = ms / 1000;
+    ts.tv_nsec = (ms % 1000) * 1000000L;
+    nanosleep(&ts, NULL);
+}
+#endif
+
+// One deadline shared across resolve/connect/send/recv for a single call.
+// enet_time_get() is a plain gettimeofday()/GetTickCount() wrapper inside
+// enet - no SDL/cube dependency needed just to track a timeout.
+struct sghttpbudget
+{
+    enet_uint32 deadline;
+    sghttpbudget(int timeoutms) : deadline(enet_time_get() + enet_uint32(timeoutms > 0 ? timeoutms : 0)) {}
+    int remaining() const
+    {
+        enet_uint32 now = enet_time_get();
+        return now >= deadline ? 0 : int(deadline - now);
+    }
+};
+
+// progress is optional (checkupdate's silent GET passes NULL); ticking with
+// no callback always allows continuing, bounded only by the time budget.
+static bool sghttptick(sghttpprogress *progress, int got, int total, bool &cancelled)
+{
+    if(progress && !progress->tick(got, total)) { cancelled = true; return false; }
+    return true;
+}
+
+// --- async DNS resolve -----------------------------------------------------
+// Mirrors engine/serverbrowser.cpp's resolverwait: a background thread runs
+// the blocking enet_address_set_host() call so the calling/render thread
+// never blocks on DNS, polled from here under the SAME budget/progress/cancel
+// plumbing as connect/send/recv. Reimplemented self-contained (a raw platform
+// thread, not SDL_Thread) so this still works under -DSTANDALONE, where
+// cube.h does not pull in SDL. Only one thread is spawned per call - sghttp
+// calls are one-shot requests, not the server browser's continuous ping
+// loop, so a persistent resolver-thread pool is not needed here.
+enum { SGHTTP_RJ_PENDING = 0, SGHTTP_RJ_DONE = 1, SGHTTP_RJ_ABANDONED = 2 };
+
+struct sghttpresolvejob
+{
+    char host[256];
+    ENetAddress address;
+    // Lock-free single-producer (worker)/single-consumer (poller) handoff via
+    // GCC/Clang __atomic builtins (see the file-top comment for why not
+    // <atomic>): whichever side's compare-exchange away from PENDING loses
+    // the race takes ownership of freeing the job - see
+    // sghttpresolvefinish() (worker side, below) and sghttpresolve() (poller
+    // side, further down).
+    int state;
+};
+
+static void sghttpresolvefinish(sghttpresolvejob *job, bool resolved)
+{
+    if(!resolved) job->address.host = ENET_HOST_ANY;
+    int expected = SGHTTP_RJ_PENDING;
+    if(!__atomic_compare_exchange_n(&job->state, &expected, SGHTTP_RJ_DONE, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+        delete job; // poller already abandoned it
+}
+
+#ifdef WIN32
+static DWORD WINAPI sghttpresolvethread(LPVOID data)
+{
+    sghttpresolvejob *job = (sghttpresolvejob *)data;
+    bool ok = enet_address_set_host(&job->address, job->host) >= 0;
+    sghttpresolvefinish(job, ok);
+    return 0;
+}
+#else
+static void *sghttpresolvethread(void *data)
+{
+    sghttpresolvejob *job = (sghttpresolvejob *)data;
+    bool ok = enet_address_set_host(&job->address, job->host) >= 0;
+    sghttpresolvefinish(job, ok);
+    return NULL;
+}
+#endif
+
+static sghttpresolvejob *sghttpresolvestart(const char *host)
+{
+    sghttpresolvejob *job = new sghttpresolvejob;
+    job->address.host = ENET_HOST_ANY;
+    job->address.port = 0;
+    job->state = SGHTTP_RJ_PENDING; // plain store - no other thread can see `job` until we return it
+    size_t len = strlen(host);
+    if(len >= sizeof(job->host)) len = sizeof(job->host) - 1;
+    memcpy(job->host, host, len);
+    job->host[len] = '\0';
+
+#ifdef WIN32
+    HANDLE t = CreateThread(NULL, 0, sghttpresolvethread, job, 0, NULL);
+    if(!t) { delete job; return NULL; }
+    CloseHandle(t); // fire-and-forget - the thread itself keeps running
+#else
+    pthread_t t;
+    if(pthread_create(&t, NULL, sghttpresolvethread, job) != 0) { delete job; return NULL; }
+    pthread_detach(t);
+#endif
+    return job;
+}
+
+// Polls under the shared budget, ticking progress each iteration (never the
+// renderer - only the caller's callback). On success, fills *address and
+// frees the job. On timeout/cancel, ABANDONS the job - the worker thread
+// (still resolving in the background) frees it whenever it eventually
+// returns, since the underlying getaddrinfo() call cannot be forcibly
+// interrupted; the calling side still returns within budget either way, so a
+// slow/dead DNS name respects timeoutms/esc-cancel here even though the OS
+// call it is waiting on does not.
+static bool sghttpresolve(const char *host, ENetAddress &address, sghttpbudget &b, sghttpprogress *progress, bool &cancelled)
+{
+    sghttpresolvejob *job = sghttpresolvestart(host);
+    if(!job) return false;
+
+    for(;;)
+    {
+        if(__atomic_load_n(&job->state, __ATOMIC_SEQ_CST) == SGHTTP_RJ_DONE)
+        {
+            bool ok = job->address.host != ENET_HOST_ANY;
+            if(ok) address.host = job->address.host;
+            delete job;
+            return ok;
+        }
+
+        int left = b.remaining();
+        if(left <= 0 || !sghttptick(progress, 0, 0, cancelled))
+        {
+            int expected = SGHTTP_RJ_PENDING;
+            if(!__atomic_compare_exchange_n(&job->state, &expected, SGHTTP_RJ_ABANDONED, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+            {
+                // worker finished right at this instant - we own cleanup now
+                bool ok = job->address.host != ENET_HOST_ANY;
+                if(ok) address.host = job->address.host;
+                delete job;
+                return ok;
+            }
+            return false; // abandoned; the worker thread frees it later
+        }
+
+        sghttpsleepms(min(left, 20));
+    }
+}
+// --- end async DNS resolve ---------------------------------------------
+
+static ENetSocket sghttpconnect(const char *host, int port, sghttpbudget &b, sghttpprogress *progress, bool &cancelled)
+{
+    ENetAddress address;
+    address.host = ENET_HOST_ANY;
+    address.port = enet_uint16(port);
+    if(!sghttpresolve(host, address, b, progress, cancelled))
+    {
+        if(!cancelled) sghttplasterr = SGHTTP_ERR_RESOLVE;
+        return ENET_SOCKET_NULL;
+    }
+
+    ENetSocket sock = enet_socket_create(ENET_SOCKET_TYPE_STREAM);
+    if(sock == ENET_SOCKET_NULL) { sghttplasterr = SGHTTP_ERR_CONNECT; return ENET_SOCKET_NULL; }
+    enet_socket_set_option(sock, ENET_SOCKOPT_NONBLOCK, 1);
+
+    if(enet_socket_connect(sock, &address) < 0) { enet_socket_destroy(sock); sghttplasterr = SGHTTP_ERR_CONNECT; return ENET_SOCKET_NULL; }
+
+    for(;;)
+    {
+        int left = b.remaining();
+        if(left <= 0 || !sghttptick(progress, 0, 0, cancelled))
+        {
+            enet_socket_destroy(sock);
+            if(!cancelled) sghttplasterr = SGHTTP_ERR_CONNECT;
+            return ENET_SOCKET_NULL;
+        }
+        enet_uint32 events = ENET_SOCKET_WAIT_SEND | ENET_SOCKET_WAIT_RECEIVE;
+        if(enet_socket_wait(sock, &events, min(left, 250)) >= 0 && events)
+        {
+            int error = 0;
+            if(enet_socket_get_option(sock, ENET_SOCKOPT_ERROR, &error) < 0 || error)
+            {
+                enet_socket_destroy(sock);
+                sghttplasterr = SGHTTP_ERR_CONNECT;
+                return ENET_SOCKET_NULL;
+            }
+            return sock;
+        }
+    }
+}
+
+static bool sghttpsend(ENetSocket sock, const char *data, int len, sghttpbudget &b, sghttpprogress *progress, bool &cancelled)
+{
+    int sentlen = 0;
+    while(sentlen < len)
+    {
+        int left = b.remaining();
+        if(left <= 0 || !sghttptick(progress, sentlen, len, cancelled))
+        {
+            if(!cancelled) sghttplasterr = SGHTTP_ERR_SEND;
+            return false;
+        }
+        enet_uint32 events = ENET_SOCKET_WAIT_SEND;
+        if(enet_socket_wait(sock, &events, min(left, 250)) >= 0 && events)
+        {
+            ENetBuffer buf;
+            buf.data = (void *)(data + sentlen);
+            buf.dataLength = len - sentlen;
+            int sent = enet_socket_send(sock, NULL, &buf, 1);
+            if(sent < 0) { sghttplasterr = SGHTTP_ERR_SEND; return false; }
+            sentlen += sent;
+        }
+    }
+    // One last tick so the caller sees 100% and gets a final cancel check
+    // before recv begins. sghttptick only ever returns false via a genuine
+    // cancel (it sets `cancelled` itself), so the `!cancelled` guard here
+    // never fires in that branch - it only matters if a future edit adds a
+    // non-cancel false path to sghttptick, so both callers here stay correct
+    // by construction rather than by the current call graph's shape.
+    if(!sghttptick(progress, sentlen, len, cancelled))
+    {
+        if(!cancelled) sghttplasterr = SGHTTP_ERR_SEND;
+        return false;
+    }
+    return true;
+}
+
+// offset of the first body byte just past the blank line, or -1 if the
+// header block has not fully arrived yet.
+static int sghttpheaderend(const char *buf, int len)
+{
+    for(int i = 3; i < len; i++)
+        if(buf[i-3] == '\r' && buf[i-2] == '\n' && buf[i-1] == '\r' && buf[i] == '\n') return i+1;
+    return -1;
+}
+
+static void sghttpparseheaders(const char *buf, int headerlen, int &status, int &contentlength)
+{
+    char *headers = new char[headerlen+1];
+    memcpy(headers, buf, headerlen);
+    headers[headerlen] = '\0';
+
+    status = 0;
+    sscanf(headers, "HTTP/%*s %d", &status);
+
+    contentlength = -1;
+    for(char *line = headers;;)
+    {
+        char *eol = strchr(line, '\n');
+        if(!strncasecmp(line, "Content-Length:", 15)) { contentlength = atoi(line+15); break; }
+        if(!eol) break;
+        line = eol+1;
+    }
+    delete[] headers;
+}
+
+// Reads the raw response into `raw` until the declared Content-Length is
+// satisfied, the peer closes the connection, or the budget runs out. Ticks
+// progress with body bytes received vs Content-Length (-1 while unknown, ie.
+// before the header block has fully arrived, or when the response omits it -
+// matches the old code's read-until-EOF fallback in that case).
+static bool sghttprecv(ENetSocket sock, vector<char> &raw, sghttpbudget &b, sghttpprogress *progress, bool &cancelled,
+                        int &status, int &headerend, int &contentlength)
+{
+    status = 0; headerend = -1; contentlength = -1;
+    for(;;)
+    {
+        if(headerend < 0)
+        {
+            int end = sghttpheaderend(raw.getbuf(), raw.length());
+            if(end >= 0)
+            {
+                headerend = end;
+                sghttpparseheaders(raw.getbuf(), headerend, status, contentlength);
+            }
+        }
+        if(headerend >= 0 && contentlength >= 0 && raw.length() - headerend >= contentlength) return true;
+
+        int left = b.remaining();
+        int bodygot = headerend >= 0 ? raw.length() - headerend : 0;
+        int bodytotal = headerend >= 0 ? contentlength : -1;
+        if(left <= 0 || !sghttptick(progress, bodygot, bodytotal, cancelled))
+        {
+            if(!cancelled) sghttplasterr = SGHTTP_ERR_RECV;
+            return false;
+        }
+
+        enet_uint32 events = ENET_SOCKET_WAIT_RECEIVE;
+        if(enet_socket_wait(sock, &events, min(left, 250)) >= 0 && events)
+        {
+            if(raw.length() >= raw.capacity()) raw.reserve(4096);
+            ENetBuffer buf;
+            buf.data = raw.getbuf() + raw.length();
+            buf.dataLength = raw.capacity() - raw.length();
+            int recv = enet_socket_receive(sock, NULL, &buf, 1);
+            if(recv <= 0)
+            {
+                if(headerend < 0) sghttplasterr = SGHTTP_ERR_RECV; // closed before headers ever arrived
+                return headerend >= 0;
+            }
+            raw.advance(recv);
+        }
+    }
+}
+
+static int sghttprequest(const char *host, int port, const char *reqhead, int reqheadlen,
+                          const char *body, int bodylen, vector<uchar> &out, int timeoutms, sghttpprogress *progress)
+{
+    sghttplasterr = SGHTTP_ERR_NONE;
+
+    sghttpbudget b(timeoutms);
+    bool cancelled = false;
+
+    ENetSocket sock = sghttpconnect(host, port, b, progress, cancelled);
+    if(sock == ENET_SOCKET_NULL) return cancelled ? -1 : 0;
+
+    vector<char> req;
+    req.put(reqhead, reqheadlen);
+    if(bodylen > 0) req.put(body, bodylen);
+
+    if(!sghttpsend(sock, req.getbuf(), req.length(), b, progress, cancelled))
+    {
+        enet_socket_destroy(sock);
+        return cancelled ? -1 : 0;
+    }
+
+    vector<char> raw;
+    int status = 0, headerend = -1, contentlength = -1;
+    bool recvok = sghttprecv(sock, raw, b, progress, cancelled, status, headerend, contentlength);
+    enet_socket_destroy(sock);
+
+    if(cancelled) return -1;
+    if(!recvok) return 0; // sghttprecv already recorded SGHTTP_ERR_RECV
+    if(status <= 0) { sghttplasterr = SGHTTP_ERR_BADREPLY; return 0; }
+
+    int bodygot = raw.length() - headerend;
+    if(contentlength >= 0) bodygot = min(bodygot, contentlength);
+    if(bodygot > 0) out.put((uchar *)raw.getbuf() + headerend, bodygot);
+
+    return status;
+}
+
+int sghttpget(const char *host, int port, const char *path, vector<uchar> &out, int timeoutms, sghttpprogress *progress)
+{
+    char head[1024];
+    snprintf(head, sizeof(head), "GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: SwiftGibs\r\nConnection: close\r\n\r\n", path, host);
+    return sghttprequest(host, port, head, int(strlen(head)), NULL, 0, out, timeoutms, progress);
+}
+
+int sghttppost(const char *host, int port, const char *path, const char *contenttype, const vector<char> &body, vector<uchar> &out, int timeoutms, sghttpprogress *progress)
+{
+    char head[1024];
+    snprintf(head, sizeof(head),
+        "POST %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: SwiftGibs\r\nContent-Type: %s\r\nContent-Length: %d\r\nConnection: close\r\n\r\n",
+        path, host, contenttype, body.length());
+    return sghttprequest(host, port, head, int(strlen(head)), body.getbuf(), body.length(), out, timeoutms, progress);
+}
