+// sghttp.h: minimal blocking HTTP/1.1 GET/POST transport over raw enet
+// sockets. Extracted from the feedback-relay code (patch 14) so later
+// features (eg. map streaming) can reuse the same transport.
+//
+// Deliberately engine-light: this header only needs shared/cube.h (for
+// vector<>/uchar and the enet/zlib types cube.h itself requires) - no
+// engine.h, no renderer, no UI. Under -DSTANDALONE (the same flag the
+// dedicated server already builds with) cube.h skips SDL/GL entirely, so
+// sghttp.cpp builds and links against nothing but enet + zlib; that is how
+// it stays testable on its own. Callers own all progress display and
+// cancellation (eg. renderprogress/interceptkey) through the sghttpprogress
+// callback; sghttp itself never touches them.
+
+#ifndef __SGHTTP_H__
+#define __SGHTTP_H__
+
+#include "cube.h"
+
+struct sghttpprogress { virtual bool tick(int got, int total) = 0; };  // false = cancel
+
+// Blocking raw-HTTP/1.1 GET (Connection: close). Returns HTTP status (200...), 0 on
+// connect/socket failure, -1 on cancel. Body bytes are appended to `out` (headers stripped,
+// Content-Length honored when present). Progress ticked from the CALLING thread.
+int sghttpget(const char *host, int port, const char *path, vector<uchar> &out,
+              int timeoutms, sghttpprogress *progress = NULL);
+
+// Blocking raw-HTTP/1.1 POST (Connection: close). Same return convention as sghttpget.
+int sghttppost(const char *host, int port, const char *path, const char *contenttype, const vector<char> &body, vector<uchar> &out, int timeoutms, sghttpprogress *progress);
+
+#endif
