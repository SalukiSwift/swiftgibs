+        string sstime;
+        time_t t = time(NULL);
+        size_t tlen = strftime(sstime, sizeof(sstime), "%Y-%m-%d_%H.%M.%S", localtime(&t));
+        sstime[min(tlen, sizeof(sstime)-1)] = '\0';
