+    // this guard, watching a demo, including a clip this feature just saved, would silently
+    // re-record itself into the ring on every rewatch. game::demoplaying() is a cheap bool
+    // read (shared/igame.h), no different in kind from the clipbuf null check inside
+    // cliprecord() itself.
+    if(!game::demoplaying()) cliprecord(chan, packet->data, (int)packet->dataLength);
     packetbuf p(packet);
     game::parsepacketclient(chan, p);
 }
