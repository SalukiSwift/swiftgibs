+// === SwiftGibs instant replay: ring buffer ============================================
+// A fixed-size byte ring of {ms, chan, len, payload} records (clipheader matches the on-disk
+// .dmo record layout used by Task 2's writer), allocated ONCE and reallocated only when
+// clips/cliplength/clipmemcap change (clipsync(), the shared VARFP body below - never per
+// frame or per packet). cliprecord() is a bounded memcpy: one length check, at most one wrap,
+// two memcpy calls. It is called from localservertoclient() below (the single inbound choke
+// point for both remote and local/offline servers) and from the game-side N_POS synthesiser
+// (fpsgame/client.cpp sendpositions()) for the player's own position, which the server never
+// echoes back to the client that sent it.
+struct clipheader { int ms, chan, len; };
+#define CLIPHDRSIZE (int)sizeof(clipheader)
+#define CLIPMINSIZE (64*1024)          // floor so a tiny clipmemcap still stores something
+
+static uchar *clipbuf = NULL;
+static int clipbufsize = 0;            // allocated bytes (0 when the feature is off)
+static int clipwritepos = 0;           // next write offset
+static bool clipfull = false;          // ring has wrapped at least once (oldest data starts at clipwritepos)
+static int clipwraplimit = 0;          // Task 2: dead-zone boundary from the most recent early wrap (see
+                                        // cliprecord() below) - bytes [clipwraplimit, clipbufsize) are stale,
+                                        // never-reharvested tail from an older lap and must never be parsed as
+                                        // a record. Written only on the (already rare) wrap branches, so this
+                                        // adds nothing to the steady-state per-record cost.
+
+bool clipactive() { return clipbuf != NULL; }
+
+static void clipsinkappend(int slot, int chan, const void *data, int len);   // fwd decl - defined in the
+                                                                              // recording-sinks block below
+
+// Writes one record, wrapping to the start of the buffer rather than tearing a record across
+// the physical end (a partial record would be unreadable). A record that could never fit even
+// in an empty ring (len bigger than the whole allocation) is dropped, not truncated. Also fans
+// the SAME record out to any active recording sink (Task 3b) - independent of whether the ring
+// itself is on, since "off is genuinely off" is a per-mode guarantee (clips 0 must not also
+// silently disable a running manual/always-on recording). This is the single point every
+// capture site (the raw packet tap below, own-position synthesis, keyframe synthesis) already
+// calls, so "capture happens once and feeds whichever sinks are active" falls out for free.
+void cliprecord(int chan, const void *data, int len)
+{
+    if(clipbuf)
+    {
+        int total = CLIPHDRSIZE + len;
+        if(total <= clipbufsize)                        // fits in the ring at all - drop it whole otherwise
+        {
+            if(clipwritepos + total > clipbufsize)      // would tear across the end - wrap first
+            {
+                clipwraplimit = clipwritepos;           // Task 2: everything from here to clipbufsize is now dead
+                clipwritepos = 0;
+                clipfull = true;
+            }
+            clipheader h = { totalmillis, chan, len };
+            memcpy(&clipbuf[clipwritepos], &h, CLIPHDRSIZE);
+            if(len) memcpy(&clipbuf[clipwritepos + CLIPHDRSIZE], data, len);
+            clipwritepos += total;
+            if(clipwritepos >= clipbufsize)             // landed exactly on the end - no dead zone this lap
+            {
+                clipwritepos = 0;
+                clipfull = true;
+                clipwraplimit = clipbufsize;
+            }
+        }
+    }
+    // Task 3b fan-out: each call is a no-op pointer check per inactive slot (CLIPSINKCOUNT is a
+    // fixed, small constant - 2 today), and a bounded memcpy pair per ACTIVE slot - no different
+    // in kind from the ring write above, still no IO/alloc/gzip anywhere in this function.
+    loopi(CLIPSINKCOUNT) clipsinkappend(i, chan, data, len);
+}
+
+static void clipfree()
+{
+    DELETEA(clipbuf);
+    clipbufsize = clipwritepos = clipwraplimit = 0;
+    clipfull = false;
+}
+
+void clipsync();   // fwd decl: VARFP bodies below call this; defined after the vars it reads
+
+// Sizing: ~600 B/s of N_POS traffic per player (measured; see docs/superpowers/specs and the
+// Task 1 report), times a generous 32-player headroom (double the design doc's 16-player
+// worst case), times 60% margin for the 12-byte record header (small payloads make the header
+// a large fraction of each record). Hard-clamped by clipmemcap so a pathological server or a
+// long cliplength cannot balloon memory - this is the only ceiling that matters in practice.
+#define CLIP_BYTES_PER_PLAYER_SEC 600
+#define CLIP_EST_PLAYERS 32
+
+VARFP(clips, 0, 1, 1, clipsync());
+VARFP(cliplength, 1, 1, 10, clipsync());
+VARFP(clipmemcap, 1, 16, 128, clipsync());
+
+void clipsync()
+{
+    if(!clips) { clipfree(); return; }
+    long long wanted = (long long)CLIP_BYTES_PER_PLAYER_SEC * CLIP_EST_PLAYERS * 60 * cliplength;
+    wanted = wanted * 8 / 5;
+    long long cap = (long long)clipmemcap * 1024 * 1024;
+    long long size = min(wanted, cap);
+    if(size < CLIPMINSIZE) size = CLIPMINSIZE;
+    if(clipbuf && (int)size == clipbufsize) return;   // no change needed
+    clipfree();
+    clipbuf = new uchar[(size_t)size];
+    clipbufsize = (int)size;
+    clipwraplimit = (int)size;
+}
+// === end SwiftGibs instant replay ring buffer ==========================================
+
+// === SwiftGibs instant replay: ring reader (Task 2) ====================================
+// Read side only, used by saveclip's writer (fpsgame/client.cpp) - never on the hot path
+// above. Exposes a clean interface (an ordered record index + a read-only data pointer)
+// rather than the raw ring statics, so a caller never has to re-derive the wrap math itself.
+// (clipentry itself is declared in shared/iengine.h, alongside cliprecord/clipactive, so
+// fpsgame/client.cpp's writer can name the type without a second, divergent definition.)
+
+// Appends every well-formed record found in src[from, to) to out, oldest first. A record only
+// counts if its whole header AND its declared payload fit inside [from, to) - this is what
+// makes the scan self-terminating at a dead-zone boundary rather than needing to special-case
+// it: the tail bytes an early wrap leaves behind (clipwraplimit..clipbufsize) are never
+// zeroed, so after the ring's first lap they hold a stale header from an older lap that would
+// otherwise be misread as a real record (and its stale len could run past clipbufsize
+// entirely - the fit check below is what stops that being read as a length to trust). Passing
+// clipwraplimit as this scan's own "to" for the old-lap half (see clipindex()) means the dead
+// zone is never even entered; the fit check is a second, redundant line of defence.
+// Takes an explicit source pointer (Task 3b: reused for a recording sink's own flat append
+// buffer, which has no wraparound to reason about at all - a plain [0, len) scan - so this one
+// walker serves both the ring and every sink rather than duplicating it).
+static void clipscan(const uchar *src, int from, int to, vector<clipentry> &out)
+{
+    int pos = from;
+    while(pos + CLIPHDRSIZE <= to)
+    {
+        clipheader h;
+        memcpy(&h, &src[pos], CLIPHDRSIZE);
+        if(h.len < 0 || pos + CLIPHDRSIZE + h.len > to) break;   // dead zone / malformed - stop here
+        clipentry &e = out.add();
+        e.ms = h.ms; e.chan = h.chan; e.len = h.len; e.offset = pos + CLIPHDRSIZE;
+        pos += CLIPHDRSIZE + h.len;
+    }
+}
+
+// Builds an oldest -> newest index of every record currently in the ring. When the ring has
+// wrapped, the true oldest data starts at clipwritepos and runs to clipwraplimit (the boundary
+// recorded by the most recent wrap in cliprecord(), never the dead zone beyond it); the newest
+// data is always [0, clipwritepos). Returns false (out left untouched) if the feature is off
+// or nothing has been captured yet.
+bool clipindex(vector<clipentry> &out)
+{
+    if(!clipbuf) return false;
+    if(clipfull) { clipscan(clipbuf, clipwritepos, clipwraplimit, out); clipscan(clipbuf, 0, clipwritepos, out); }
+    else clipscan(clipbuf, 0, clipwritepos, out);
+    return out.length() > 0;
+}
+
+// Read-only view of the ring's backing bytes; clipentry::offset (from clipindex() above)
+// indexes into this. NULL when the feature is off. Valid only until the next cliprecord()
+// call - fine for saveclip, which indexes and writes the whole file as one synchronous
+// command with no engine tick (and so no cliprecord() call) able to run in between.
+const uchar *clipdata() { return clipbuf; }
+// === end SwiftGibs instant replay ring reader ===========================================
+
+// === SwiftGibs instant replay: recording sinks (Task 3b) ================================
+// Two more consumers of the exact same capture points the ring already uses (the raw packet
+// tap below, plus the game-side own-position/keyframe synthesis in fpsgame/client.cpp): a
+// manual start/stop recording and an always-on match recording. Each is a small FLAT append
+// buffer, not a ring - fpsgame/client.cpp drains and resets it on a periodic (~1s) tick
+// (checkcliprecordflush()), so it only ever needs to hold about one flush interval's worth of
+// bytes, never the whole recording. CLIPSINKBUFCAP is sized well above clipsync()'s own
+// theoretical worst case (32 players * 600 B/s * 1.6 header margin ~= 30.7 KB/s, see clipsync()
+// above) so a delayed flush never has to drop a record in ordinary play; a genuinely
+// pathological burst still degrades gracefully (the record is dropped, exactly like an
+// oversized ring record - see cliprecord() above) rather than growing the buffer or blocking.
+// Allocated only while that specific mode is actually running - inactive, both are NULL, no
+// memory held, the same "off is genuinely off" guarantee the ring already gives, per-mode.
+#define CLIPSINKBUFCAP (96*1024)
+
+struct clipsink { uchar *buf; int len; };
+static clipsink clipsinkbufs[CLIPSINKCOUNT] = { {NULL, 0}, {NULL, 0} };
+
+bool clipsinkactive(int slot) { return clipsinkbufs[slot].buf != NULL; }
+bool clipanysinkactive() { return clipsinkbufs[CLIPSINK_MANUAL].buf != NULL || clipsinkbufs[CLIPSINK_AUTO].buf != NULL; }
+
+void clipsinkstart(int slot)
+{
+    clipsink &s = clipsinkbufs[slot];
+    if(s.buf) return;              // already running - callers check first anyway, stays idempotent
+    s.buf = new uchar[CLIPSINKBUFCAP];
+    s.len = 0;
+}
+
+void clipsinkstop(int slot)
+{
+    clipsink &s = clipsinkbufs[slot];
+    DELETEA(s.buf);
+    s.len = 0;
+}
+
+// Appends one record to ONE sink's buffer. Called for every slot (active or not) from
+// cliprecord() above - the single fan-out point every capture site already calls - and is a
+// no-op pointer check when that slot isn't running, no different in kind from cliprecord()'s
+// own ring-off fast path.
+static void clipsinkappend(int slot, int chan, const void *data, int len)
+{
+    clipsink &s = clipsinkbufs[slot];
+    if(!s.buf) return;
+    int total = CLIPHDRSIZE + len;
+    if(s.len + total > CLIPSINKBUFCAP) return;   // flush overdue under a pathological burst - drop, don't grow/block
+    clipheader h = { totalmillis, chan, len };
+    memcpy(&s.buf[s.len], &h, CLIPHDRSIZE);
+    if(len) memcpy(&s.buf[s.len + CLIPHDRSIZE], data, len);
+    s.len += total;
+}
+
+// Public single-target write, bypassing the fan-out above. Used only for a fresh recording's
+// own synthesised opening keyframe (fpsgame/client.cpp startcliprecorder()) - that keyframe
+// belongs to the ONE sink that just started, not to the ring, and not to any OTHER sink that
+// also happens to be active at that moment (cliprecord()'s fan-out would otherwise leak a
+// redundant, playback-breaking N_WELCOME/N_MAPCHANGE bundle into an unrelated in-progress
+// recording).
+void clipsinkput(int slot, int chan, const void *data, int len) { clipsinkappend(slot, chan, data, len); }
+
+// Read side for the periodic flush (fpsgame/client.cpp checkcliprecordflush()): parses every
+// well-formed record currently buffered, oldest first. A flat append buffer, so this is a
+// plain [0, len) scan with no wraparound to reason about, unlike the ring - clipscan() (above)
+// is reused verbatim via its generalised source-buffer parameter rather than duplicated.
+bool clipsinkindex(int slot, vector<clipentry> &out)
+{
+    clipsink &s = clipsinkbufs[slot];
+    if(!s.buf || !s.len) return false;
+    clipscan(s.buf, 0, s.len, out);
+    return out.length() > 0;
+}
+const uchar *clipsinkdata(int slot) { return clipsinkbufs[slot].buf; }
+
+// Clears the buffer back to empty. Called only after the caller (the periodic flush) has
+// actually written out every entry clipsinkindex() just handed back - a failed/short write can
+// simply re-flush next tick instead of silently losing buffered records.
+void clipsinkreset(int slot) { clipsinkbufs[slot].len = 0; }
+// === end SwiftGibs instant replay recording sinks ========================================
