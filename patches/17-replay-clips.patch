+        if(starti < 0) starti = earliesti;
+        if(starti < 0) { conoutf("saveclip: no keyframe recorded yet - try again in a moment"); return; }
+
+        const uchar *data = clipdata();
+        if(!data) { conoutf("saveclip: replay clips are off (clips 1 to enable)"); return; }
+
+        string mapname;
+        string mode;
+        clipsanitize(mapname, sizeof(mapname), clientmap, "map");
+        clipsanitize(mode, sizeof(mode), server::modename(gamemode), "mode");
+
+        string sstime;
+        time_t t = time(NULL);
+        size_t tlen = strftime(sstime, sizeof(sstime), "%Y-%m-%d_%H.%M.%S", localtime(&t));
+        sstime[min(tlen, sizeof(sstime)-1)] = '\0';
+
+        defformatstring(relpath, "%s%s%s_%s_%s.dmo", clipdir, clipdir[0] ? "/" : "", sstime, mapname, mode);
+
+        stream *f = opengzfile(path(relpath, true), "wb");
+        if(!f) { conoutf("saveclip: could not write %s", relpath); return; }
+
+        demoheader hdr;
+        memcpy(hdr.magic, DEMO_MAGIC, sizeof(hdr.magic));
+        hdr.version = DEMO_VERSION;
+        hdr.protocol = PROTOCOL_VERSION;
+        lilswap(&hdr.version, 2);
+        f->write(&hdr, sizeof(demoheader));
+
+        int basems = idx[starti].ms;
+        int lastms = basems;
+        for(int i = starti; i < idx.length(); i++)
+        {
+            // Only the STARTING keyframe carries the full synthesised welcome bundle - a
+            // later one inside the same clip window is redundant (real incremental packets
+            // already keep a live client in sync) and actively harmful to include: its own
+            // N_MAPCHANGE would force an extra, jarring map reload mid-playback. Skip it
+            // entirely rather than translate it - lastms is left untouched so the reported
+            // duration still reflects the true span of what got written.
+            if(idx[i].chan == CLIPCHAN_KEYFRAME && i != starti) continue;
+            int stamp[3];
+            stamp[0] = idx[i].ms - basems;
+            stamp[1] = idx[i].chan == CLIPCHAN_KEYFRAME ? 1 : idx[i].chan;
+            stamp[2] = idx[i].len;
+            lilswap(stamp, 3);
+            f->write(stamp, sizeof(stamp));
+            if(idx[i].len) f->write(&data[idx[i].offset], idx[i].len);
+            lastms = idx[i].ms;
+        }
+        delete f;
+
+        conoutf("saved clip: %s (%.1fs)", relpath, (lastms-basems)/1000.0f);
+    }
+    COMMAND(saveclip, "");
+    // === end SwiftGibs instant replay: keyframes + clip writing =============================
+
+    // === SwiftGibs instant replay: recording modes (Task 3b) ================================
+    // Two more consumers of the same recorder core (Tasks 1-2): a manual start/stop recording
+    // and an always-on match recording, both streamed incrementally to their own gzipped .dmo
+    // via the small per-mode append buffer engine/client.cpp exposes (clipsinkstart/put/index/
+    // data/reset - see that file's "recording sinks" block). Unlike saveclip() above, which
+    // snapshots the whole ring in one synchronous write, these two write INCREMENTALLY: records
+    // land in the sink's small buffer via cliprecord()'s fan-out (engine/client.cpp) as they're
+    // captured, and checkcliprecordflush() below (called once per c2sinfo() tick, throttled to
+    // roughly once a second) is the ONLY place that ever touches the actual file - opening,
+    // writing, and gzip compression all happen there, never on the per-packet path. Every
+    // capture site's own per-packet cost is unchanged by this (still a bounded memcpy into a
+    // flat buffer, see engine/client.cpp cliprecord()/clipsinkappend()); the flush itself is
+    // real file IO plus gzip work, but it runs at most once a second, never once per packet.
+    //
+    // Filenames distinguish recordings from clips: a clip (saveclip() above) is
+    // "<timestamp>_<map>_<mode>.dmo"; a recording is "<timestamp>_<map>_<mode>_rec-<label>.dmo"
+    // (label = "manual" or "auto") - the retention pruner below matches ONLY that literal
+    // suffix, so it can never mistake a clip (or any unrelated file) for a recording it wrote.
+
+    VARP(cliprecordauto, 0, 0, 1);          // always-on match recording; OFF by default
+    VARP(cliprecordkeep, 0, 20, 200);       // "keep newest N recordings" retention; 0 = never prune
+
+    struct cliprecorder
+    {
+        stream *f;           // open gzip file handle while recording; NULL otherwise
+        string relpath;       // for console messages
+        int basems;           // ms of the first record ever written (rebase origin); -1 = not yet set
+        int lastms;           // ms of the most recently written record (for duration reporting)
+        bool wrotekeyframe;   // true once this stream's one allowed opening keyframe has been written
+    };
+    static cliprecorder manualrec = { NULL, "", -1, 0, false };
+    static cliprecorder autorec   = { NULL, "", -1, 0, false };
+    static bool cliprecordarmed = false;   // set by cliprecordarmmatchstart() (fpsgame/fps.cpp startgame()
+                                            // hook); consumed on the very next c2sinfo() tick, once the
+                                            // whole welcome bundle for a fresh match (incl. the item list,
+                                            // which arrives in the SAME inbound packet but is only parsed
+                                            // AFTER startgame() returns) has fully settled - starting the
+                                            // sink synchronously inside startgame() itself would synthesise
+                                            // an opening keyframe with a stale/empty item list.
+
+    // SwiftGibs fps stats (patches/18-fps-stats.patch) benchmark row: whether a recording sink
+    // (manual OR always-on) was actually opened at any point during the CURRENT match, as
+    // opposed to merely "is one running right now at match end" - a manual F9 toggle that
+    // started and stopped mid-match, or an always-on recording that was already finalised at
+    // intermission before fpsstatsmatchend() runs, would otherwise read as "off". Latched true
+    // in startcliprecorder() below (the single choke point both recording modes start through),
+    // cleared in cliprecordarmmatchstart() (called once per real match start, fpsgame/fps.cpp
+    // startgame() - the same per-match cadence patches/18's own fpsstatsmatchstart() uses to
+    // discard/reset a previous match's sampling), and read by fpsstatsmatchend() via
+    // cliprecordwasactivematch() below - never on the per-frame path.
+    static bool cliprecordseenthismatch = false;
+
+    bool cliprecordmanualactive() { return manualrec.f != NULL; }
+    bool cliprecordautoactive() { return autorec.f != NULL; }
+    bool cliprecordwasactivematch() { return cliprecordseenthismatch; }   // SwiftGibs fps stats accessor
+
+    // Opens <clipdir>/<timestamp>_<map>_<mode>_rec-<label>.dmo (same gzipped stock demo format
+    // saveclip() writes: 24-byte header, then {ms,chan,len} stamps + payload), starts the
+    // engine-side sink buffer for `slot`, and seeds it with ONE synthesised opening keyframe
+    // (writeclipwelcome() - the exact same welcome-equivalent builder the ring's periodic
+    // keyframes use) via clipsinkput() - a targeted, single-sink write, not the general
+    // cliprecord() fan-out, so this keyframe cannot leak into the ring or into any OTHER
+    // currently-active sink. Every real packet from this point on reaches the sink through the
+    // ordinary capture path (cliprecord()'s fan-out), same as the ring.
+    static void startcliprecorder(cliprecorder &r, int slot, const char *label)
+    {
+        if(r.f) return;   // already running - callers check first anyway, stays idempotent
+
+        string mapname, mode, sstime;
+        clipsanitize(mapname, sizeof(mapname), clientmap, "map");
+        clipsanitize(mode, sizeof(mode), server::modename(gamemode), "mode");
+        time_t t = time(NULL);
+        size_t tlen = strftime(sstime, sizeof(sstime), "%Y-%m-%d_%H.%M.%S", localtime(&t));
+        sstime[min(tlen, sizeof(sstime)-1)] = '\0';
+        defformatstring(relpath, "%s%s%s_%s_%s_rec-%s.dmo", clipdir, clipdir[0] ? "/" : "", sstime, mapname, mode, label);
+
+        stream *f = opengzfile(path(relpath, true), "wb");
+        if(!f) { conoutf("record: could not write %s", relpath); return; }
+
+        demoheader hdr;
+        memcpy(hdr.magic, DEMO_MAGIC, sizeof(hdr.magic));
+        hdr.version = DEMO_VERSION;
+        hdr.protocol = PROTOCOL_VERSION;
+        lilswap(&hdr.version, 2);
+        f->write(&hdr, sizeof(demoheader));
+
+        r.f = f;
+        copystring(r.relpath, relpath);
+        r.basems = -1;
+        r.lastms = 0;
+        r.wrotekeyframe = false;
+        cliprecordseenthismatch = true;   // SwiftGibs fps stats: a sink actually opened this match
+
+        clipsinkstart(slot);
+        packetbuf p(MAXTRANS);
+        writeclipwelcome(p);
+        clipsinkput(slot, CLIPCHAN_KEYFRAME, p.buf, p.len);
+
+        conoutf("recording started (%s): %s", label, relpath);
+    }
+
+    // A map-change finalise (cliprecordfinalizeall("map change"), called from the TOP of
+    // fpsgame/fps.cpp startgame()) races the raw packet tap: localservertoclient()
+    // (engine/client.cpp) captures a packet's bytes into whichever sinks are active BEFORE
+    // parsing even begins, and startgame() itself only runs LATER, mid-parse, as a
+    // consequence of parsing that SAME packet's N_MAPCHANGE. So the very packet that triggers
+    // this finalise - the NEW match's own N_MAPCHANGE - has, by the time finishcliprecorder()
+    // runs, already been appended to the OLD (about-to-close) sink. Detected by content (a
+    // reliable-channel record whose payload starts with the raw N_MAPCHANGE opcode byte -
+    // putint()'s small-int encoding is exactly one byte for values under 128, and N_MAPCHANGE
+    // is one) rather than avoided architecturally, because nothing CAN run between the tap and
+    // the parse that triggers it - this mirrors the same tap-precedes-hook constraint Task 2
+    // already reasoned about for the opening side (synthesising a keyframe rather than relying
+    // on capturing a real welcome "naturally").
+    static bool isleadingmapchange(const uchar *payload, int len) { return len > 0 && payload[0] == N_MAPCHANGE; }
+
+    // Drains whatever the sink has buffered since the last flush (or since start), translating
+    // each record to the on-disk stamp exactly as saveclip() does (rebase ms, lilswap the
+    // stamp, translate the CLIPCHAN_KEYFRAME sentinel back to the real chan 1) and appending it
+    // to the already-open file. Only the FIRST keyframe this stream ever sees is honoured - any
+    // later one (e.g. a ring-triggered periodic keyframe that also reached this sink because
+    // both were active at once) is skipped, exactly like saveclip()'s own redundant-keyframe
+    // fix, for the same reason: a second N_MAPCHANGE mid-file forces a jarring reload. This is
+    // the ONLY place that does file IO or gzip work for a recording - called at most once a
+    // second in the ordinary case (checkcliprecordflush() below), never from the per-packet
+    // capture path. `attrimtrailingmapchange` is only ever passed true from finishcliprecorder()
+    // (a finalise, never an ordinary periodic tick) - see isleadingmapchange() above for why:
+    // dropping a record on an ordinary tick would risk losing real mid-match content, but at
+    // finalise time the sink's very last record, if it matches, can only be the leaked packet
+    // that caused this finalise in the first place, never legitimate history.
+    static void flushcliprecorder(cliprecorder &r, int slot, bool trimtrailingmapchange = false)
+    {
+        if(!r.f) return;
+        vector<clipentry> idx;
+        if(!clipsinkindex(slot, idx)) return;   // nothing buffered since the last flush - normal, no IO
+        const uchar *data = clipsinkdata(slot);
+        int count = idx.length();
+        if(trimtrailingmapchange && count > 0)
+        {
+            clipentry &last = idx[count-1];
+            if(last.chan == 1 && isleadingmapchange(&data[last.offset], last.len)) count--;
+        }
+        for(int i = 0; i < count; i++)
+        {
+            if(idx[i].chan == CLIPCHAN_KEYFRAME)
+            {
+                if(r.wrotekeyframe) continue;
+                r.wrotekeyframe = true;
+            }
+            if(r.basems < 0) r.basems = idx[i].ms;
+            int stamp[3];
+            stamp[0] = idx[i].ms - r.basems;
+            stamp[1] = idx[i].chan == CLIPCHAN_KEYFRAME ? 1 : idx[i].chan;
+            stamp[2] = idx[i].len;
+            lilswap(stamp, 3);
+            r.f->write(stamp, sizeof(stamp));
+            if(idx[i].len) r.f->write(&data[idx[i].offset], idx[i].len);
+            r.lastms = idx[i].ms;
+        }
+        clipsinkreset(slot);   // the trimmed trailing record (if any) is simply discarded, never
+                                // written anywhere - correct: it belongs to the NEXT match, which
+                                // gets its own proper (synthesised-keyframe) opening instead, and
+                                // the sink is about to be stopped, not resumed.
+    }
+
+    // Keeps only the newest cliprecordkeep files this feature's recorders wrote (name pattern
+    // "*_rec-manual.dmo" / "*_rec-auto.dmo" - a clip from saveclip() never carries that suffix,
+    // and neither does anything a player might have dropped into the folder themselves).
+    // cliprecordkeep 0 = never prune. Conservative on purpose: matches on a literal filename
+    // SUFFIX, not a substring search, so a sanitised map/mode name could never coincidentally
+    // trigger a false match anywhere else in a filename.
+    static bool cliprecordmatch(const char *name)   // name as listfiles() returns it: no ".dmo" extension
+    {
+        static const char *suffixes[] = { "_rec-manual", "_rec-auto" };
+        size_t n = strlen(name);
+        loopi(2)
+        {
+            size_t sl = strlen(suffixes[i]);
+            if(n >= sl && !strcmp(name + (n - sl), suffixes[i])) return true;
+        }
+        return false;
+    }
+
+    // SwiftGibs playtest fix (April's Windows bundle: clips menu lists each clip twice, files
+    // NOT actually duplicated on disk - unique checksums). Root cause: the Windows bundle runs
+    // with the game's home directory set equal to its own install directory, so listfiles()
+    // (shared/stream.cpp) double-registers every clipdir entry - once via its relative-cwd
+    // scan, once via its homedir scan, both resolving to the exact same physical folder. The
+    // Linux harness never reproduced this because its home dir is always separate from the
+    // bundle dir. Rather than touch listfiles() itself (shared by many unrelated subsystems -
+    // maps, sounds, demos), every clipdir listing consumer here dedupes its own listfiles()
+    // result: sort (already needed for chronological order) then drop adjacent identical
+    // names, freeing the now-redundant duplicate string. Used by BOTH clipfilecount() below
+    // (the clips-menu enumeration) and pruneclipdir() below (the retention pruner) -
+    // the same double registration would otherwise also make pruneclipdir() count every
+    // recording twice and over-prune by roughly half.
+    static void dedupclipfiles(vector<char *> &files)
+    {
+        files.sort();
+        for(int i = files.length()-1; i > 0; i--)
+        {
+            if(!strcmp(files[i], files[i-1])) delete[] files.remove(i);
+        }
+    }
+
+    static void pruneclipdir()
+    {
+        if(cliprecordkeep <= 0) return;
+        vector<char *> files;
+        listfiles(clipdir, "dmo", files);
+        dedupclipfiles(files);   // collapses the double registration (see above) before counting
+        vector<char *> matches;
+        loopv(files) { if(cliprecordmatch(files[i])) matches.add(files[i]); }
+        // files is already sorted by dedupclipfiles() above, so matches (a filtered
+        // subsequence of it) is already in chronological order too - no separate sort needed.
+        int todelete = matches.length() - cliprecordkeep;
+        for(int i = 0; i < todelete; i++)
+        {
+            defformatstring(relpath, "%s/%s.dmo", clipdir, matches[i]);
+            const char *real = findfile(path(relpath, true), "rb");
+            if(real) remove(real);
+        }
+        files.deletearrays();
+    }
+
+    // === SwiftGibs instant replay: clip folder listing (playback discoverability fix) =======
+    // April's playtest-1 bug: clips land in clipdir, but neither the stock `demo` command nor
+    // the stock demo browser ever look there (both only know demodir). April's chosen fix
+    // (design doc "Playback discoverability") keeps clipdir separate and gives it its own
+    // playback surface: `playclip <name>` (a CubeScript name-resolution shim, overlay/
+    // autoexec.cfg, that builds <clipdir>/<name>.dmo and hands off to the exact same
+    // "stopdemo; if (mode -1) [map ...]" sequence the stock `demo` alias runs - no new demo
+    // reader) and this browser page's C++ backing, following the exact fpsstatscount()/
+    // fpsstatsline() division of labour (patches/18-fps-stats.patch, fpsgame/fps.cpp): C++ owns
+    // the directory read, the sort, and the label parsing; the CubeScript page is a pure viewer
+    // + click-to-play front end.
+    //
+    // Same listfiles(clipdir, "dmo", ...) call pruneclipdir() above already makes - filenames
+    // come back WITHOUT the .dmo extension (shared/stream.cpp listdir() strips a matched ext).
+    // CONTRACT with overlay/menus_settings.cfg's "clips" page: clipfilecount() refreshes this
+    // cache (one listfiles()+dedupclipfiles() per call - see dedupclipfiles() above for why the
+    // dedup step exists); clipfilename()/clipfileline() only ever READ the cache, never list
+    // the directory themselves - the page calls clipfilecount() exactly once per frame (into
+    // sgClipTotal, before any per-row accessor), so a frame the page is visible costs one
+    // directory read total, not one per row. Sorted ascending (filenames are timestamp-
+    // prefixed, so lexicographic order is chronological order - the same fact pruneclipdir()
+    // above already relies on); accessors index from the END of the cache so row 0 is always
+    // the newest file.
+    static vector<char *> cliplistcache;
+
+    ICOMMAND(clipfilecount, "", (),
+    {
+        cliplistcache.deletearrays();
+        listfiles(clipdir, "dmo", cliplistcache);
+        dedupclipfiles(cliplistcache);   // see pruneclipdir() above: same double-registration fix
+        intret(cliplistcache.length());
+    });
+
+    // Filename WITH the .dmo extension restored - exactly what playclip (and a manual
+    // `/demo clips/<name>`) both expect. Never touches the filesystem itself (see CONTRACT
+    // above) - reads the cache clipfilecount() just refreshed.
+    ICOMMAND(clipfilename, "i", (int *i),
+    {
+        int n = cliplistcache.length();
+        if(*i < 0 || *i >= n) { result(""); return; }
+        defformatstring(name, "%s.dmo", cliplistcache[n-1-*i]);
+        result(name);
+    });
+
+    // Best-effort display label, never load-bearing: clipfilename() above always returns the
+    // exact name playclip needs, regardless of how well this parses. Filenames are written by
+    // saveclip()/startcliprecorder() above as a fixed-width 19-character "YYYY-MM-DD_HH.MM.SS"
+    // timestamp, an underscore, then "<map>_<mode>", optionally followed by "_rec-manual" or
+    // "_rec-auto" (startcliprecorder()'s label - a plain clip from saveclip() never carries that
+    // suffix, the same distinction cliprecordmatch() above already relies on). The timestamp is
+    // sliced by fixed POSITION, not by delimiter, because clipsanitize() legally allows '_'
+    // inside a sanitised map name; splitting map from mode instead uses the LAST underscore,
+    // because no stock mode name (fpsgame/game.h gamemodes[]) ever contains one once its spaces
+    // are stripped by that same sanitiser (e.g. "insta ctf" -> "instactf") - so the rightmost
+    // segment is always the mode, whatever the map name itself contains.
+    ICOMMAND(clipfileline, "i", (int *i),
+    {
+        int n = cliplistcache.length();
+        if(*i < 0 || *i >= n) { result(""); return; }
+        const char *raw = cliplistcache[n-1-*i];
+        int len = (int)strlen(raw);
+
+        const char *kind = "clip";
+        int striplen = 0;
+        if(len > 11 && !strcmp(raw+len-11, "_rec-manual")) { kind = "recording"; striplen = 11; }
+        else if(len > 9 && !strcmp(raw+len-9, "_rec-auto")) { kind = "auto-rec"; striplen = 9; }
+
+        if(len >= 20 && raw[10] == '_')
+        {
+            string ts;
+            copystring(ts, raw, 20);   // "YYYY-MM-DD_HH.MM.SS" + NUL, fixed 19+1 bytes
+            ts[10] = ' ';               // date/time separator, easier to read than the raw '_'
+
+            int bodylen = len - 20 - striplen;   // "<map>_<mode>", the type suffix already excluded
+            string body;
+            if(bodylen > 0 && bodylen < (int)sizeof(body)) copystring(body, raw+20, bodylen+1);
+            else copystring(body, "?");
+
+            char *sep = strrchr(body, '_');
+            if(sep)
+            {
+                *sep = '\0';
+                defformatstring(line, "%s   %s / %s   [%s]", ts, body, sep+1, kind);
+                result(line);
+            }
+            else
+            {
+                defformatstring(line, "%s   %s   [%s]", ts, body, kind);
+                result(line);
+            }
+        }
+        else
+        {
+            // Doesn't match the shape our own writers produce (e.g. a file dropped into clipdir
+            // by hand) - show the raw name rather than garbage-parse it.
+            defformatstring(line, "%s   [%s]", raw, kind);
+            result(line);
+        }
+    });
+    // === end SwiftGibs instant replay: clip folder listing ===================================
+
+    // Closes+saves an in-progress recording: drains any still-buffered records first (so a
+    // finalise is never lossy relative to the last flush), then closes the file and frees the
+    // sink. `reason` is purely for the console message ("stopped", "map change",
+    // "intermission", "disconnect") - interruption safety means every one of those paths routes
+    // through here rather than leaving a file open, unflushed, or lost.
+    static void finishcliprecorder(cliprecorder &r, int slot, const char *label, const char *reason)
+    {
+        if(!r.f) return;
+        flushcliprecorder(r, slot, true);
+        delete r.f;
+        r.f = NULL;
+        clipsinkstop(slot);
+        conoutf("recording saved (%s, %s): %s (%.1fs)", label, reason, r.relpath, r.basems >= 0 ? (r.lastms - r.basems)/1000.0f : 0.0f);
+        pruneclipdir();
+    }
+
+    // Finalises WHATEVER is currently running (manual and/or auto - each no-ops independently
+    // if not active) - the single hook called from every interruption point (fpsgame/fps.cpp
+    // startgame()/timeupdate(), and gamedisconnect() below), so a map change, intermission,
+    // disconnect, or quit can never silently lose an in-progress recording.
+    void cliprecordfinalizeall(const char *reason)
+    {
+        finishcliprecorder(manualrec, CLIPSINK_MANUAL, "manual", reason);
+        finishcliprecorder(autorec, CLIPSINK_AUTO, "auto", reason);
+    }
+
+    // Manual start/stop (a named, bindable action - F9 by default, see overlay/autoexec.cfg).
+    void togglerecord()
+    {
+        if(manualrec.f) { finishcliprecorder(manualrec, CLIPSINK_MANUAL, "manual", "stopped"); return; }
+        if(!connected) { conoutf("record: not connected"); return; }
+        if(demoplayback) { conoutf("record: can't record during demo playback"); return; }
+        if(editmode) { conoutf("record: can't record in edit mode"); return; }
+        startcliprecorder(manualrec, CLIPSINK_MANUAL, "manual");
+    }
+    COMMAND(togglerecord, "");
+
+    // Always-on: only ever (re)armed from cliprecordarmmatchstart() below, once per real match
+    // start - never starts mid-match just because the VARP was flipped on, matching the design's
+    // "starts at match/map start" (simplicity over capturing a partial first match).
+    static void cliprecordmatchstart()
+    {
+        if(!cliprecordauto || !connected || editmode || m_edit || demoplayback) return;
+        startcliprecorder(autorec, CLIPSINK_AUTO, "auto");
+    }
+
+    void cliprecordarmmatchstart() { cliprecordarmed = true; cliprecordseenthismatch = false; }
+
+    // Called once per c2sinfo() tick (see below). Consumes the "a match just started" flag
+    // (armed synchronously from fpsgame/fps.cpp startgame(), consumed here one tick later so
+    // the whole welcome bundle - including the item list, parsed AFTER startgame() returns - is
+    // fully settled before writeclipwelcome() reads it), then throttles the actual flush to
+    // roughly once a second. Off/idle cost: a bool check plus a static-int compare - the
+    // per-second file IO/gzip work only runs when a recording is actually active.
+    void checkcliprecordflush()
+    {
+        if(cliprecordarmed) { cliprecordarmed = false; cliprecordmatchstart(); }
+        static int lastcliprecordflush = -1000000;
+        if(totalmillis - lastcliprecordflush < 1000) return;
+        lastcliprecordflush = totalmillis;
+        flushcliprecorder(manualrec, CLIPSINK_MANUAL);
+        flushcliprecorder(autorec, CLIPSINK_AUTO);
+    }
+    // === end SwiftGibs instant replay: recording modes =======================================
+
     void c2sinfo(bool force) // send update to the server
