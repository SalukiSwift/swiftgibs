+// sgsha256.h: vendored public-domain SHA-256.
+//
+// The algorithm/implementation is derived from Brad Conte's public-domain
+// SHA-256 (https://github.com/B-Con/crypto-algorithms, sha256.h/sha256.c),
+// released by the author into the public domain - see the provenance/
+// license note at the top of sgsha256.cpp for the exact dedication text.
+// Renamed to the sgsha256_* prefix and wrapped behind the single hex-digest
+// entry point below; the compression core is the standard FIPS 180-4
+// SHA-256 algorithm, unmodified.
+//
+// Deliberately has NO engine includes (no cube.h/tools.h/anything else from
+// this codebase) so this header+source pair compiles standalone with plain
+// g++ - tools/test-manifest.sh depends on that to verify the two FIPS 180-4
+// test vectors in isolation, outside the full engine build.
+
+#ifndef __SGSHA256_H__
+#define __SGSHA256_H__
+
+#ifndef _TOOLS_H
+// shared/tools.h (if already included earlier in this translation unit -
+// true for every real engine .cpp) already provides `uchar`. Only define
+// our own when building standalone, where tools.h is never pulled in.
+typedef unsigned char uchar;
+#endif
+
+// Writes the 64 lowercase hex chars + NUL terminator of the SHA-256 digest
+// of data[0..len) into out65.
+void sgsha256hex(const uchar *data, int len, char out65[65]);
+
+#endif
