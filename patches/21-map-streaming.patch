+// mapstream.h: shipped map manifest (format, load, lookup) plus the
+// background downloader that fetches a missing map's .ogz (+.wpt) from
+// mapstreamurl on demand.
+//
+// data/mapmanifest.cfg format - one line per map, space-separated:
+//   <name> <ogzbytes> <ogzsha256hex> [<wptbytes> <wptsha256hex>]
+// Generated offline by build/make-map-manifest.sh from the official 2020
+// data. wptsize 0 means the map has no waypoint file.
+//
+// Manifest load/lookup was Task 4. Task 5 (below) adds the actual fetch/
+// verify/store machinery that consumes these entries to pull maps on demand
+// instead of shipping them all in the bundle - see mapstream.cpp for the
+// download mechanics (background SDL thread, sha256 verify, .part+rename).
+
+#ifndef __MAPSTREAM_H__
+#define __MAPSTREAM_H__
+
+#include "cube.h"
+
+struct mapmanifestentry { string name; int ogzsize; string ogzsha; int wptsize; string wptsha; }; // wptsize 0 = no wpt
+
+void loadmapmanifest();                                   // reads data/mapmanifest.cfg, silent no-op if absent
+const mapmanifestentry *mapmanifestfind(const char *name);
+
+// --- Task 5: background map downloader ---------------------------------
+// mapstreamurl: host+path the streamer fetches <name>.ogz/<name>.wpt from,
+// eg. "http://swiftgibs.salukiswift.com/maps" -> GET .../maps/fdm6.ogz. No
+// trailing slash. Defined (SVARP) in mapstream.cpp; declared extern here so
+// other files can read/report the current value - a plain SVARP(...) macro
+// invocation can't live in a header included by more than one translation
+// unit (mapstream.h is also included by fpsgame/fps.cpp), since the macro
+// expands to an actual variable definition and would collide at link time.
+extern char *mapstreamurl;
+
+enum { MS_IDLE = 0, MS_ACTIVE, MS_DONE, MS_FAILED };
+
+// Begin fetching <name>.ogz (+wpt if the manifest lists one) on the
+// background thread. Preconditions checked inside: manifest entry exists,
+// file absent. Returns false if not startable (also false while another
+// fetch is already active).
+bool mapstreambegin(const char *name);
+int  mapstreamstate();                       // MS_*
+float mapstreamprogress();                   // 0..1 of current file
+const char *mapstreamstatustext();           // "downloading fdm6 (0.6 MB)" / failure reason
+void mapstreamcancel();                      // async-safe; thread notices within one wait tick
+
+#endif
