+// mapstream.h: shipped map manifest - format, load, lookup.
+//
+// data/mapmanifest.cfg format - one line per map, space-separated:
+//   <name> <ogzbytes> <ogzsha256hex> [<wptbytes> <wptsha256hex>]
+// Generated offline by build/make-map-manifest.sh from the official 2020
+// data. wptsize 0 means the map has no waypoint file.
+//
+// This is the load/lookup slice only (Task 4) - later tasks add the actual
+// fetch/stream/cache machinery that consumes these entries to pull maps on
+// demand instead of shipping them all in the bundle.
+
+#ifndef __MAPSTREAM_H__
+#define __MAPSTREAM_H__
+
+#include "cube.h"
+
+struct mapmanifestentry { string name; int ogzsize; string ogzsha; int wptsize; string wptsha; }; // wptsize 0 = no wpt
+
+void loadmapmanifest();                                   // reads data/mapmanifest.cfg, silent no-op if absent
+const mapmanifestentry *mapmanifestfind(const char *name);
+
+#endif
