+        DIR *d = opendir(dir);
+        if(!d) return;
+        struct dirent *de;
+        while((de = readdir(d)) != NULL)
+        {
+            size_t n = strlen(de->d_name);
+            if(n <= 4 || strcmp(de->d_name+n-4, ".dmo")) continue;
+            sgclipprunefile &e = entries.add();
+            copystring(e.name, de->d_name, min((size_t)sizeof(e.name), n-3));
+            copystring(e.dir, dir);
+        }
+        closedir(d);
+#endif
+    }
