+                if(ok && job.len) ok = gzwrite(gz, job.buf, (unsigned)job.len) == job.len;
+                if(gz) { if(gzclose(gz) != Z_OK) ok = false; }
+                delete[] job.buf;
+                sgclipresult &r = results.add();
