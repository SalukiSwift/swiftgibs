+// SwiftGibs preload pass (patch 23, slate C): playsoundpitched()'s cache-warm logic
+// (load the base sample + resample it) without ever playing anything - lets map load /
+// a pitch-slider VARP change pay the decode+resample cost instead of the first hit/fire/
+// reload of a session paying it on the frame thread. Mirrors playsoundpitched() exactly;
+// pitch==100 is a deliberate no-op there too (playsoundname() never touches this cache).
+void preloadpitched(const char *s, int pitch)
+{
+    if(nosound || !s || !s[0]) return;
+    pitch = clamp(pitch, 50, 200);
+    if(pitch == 100) return;
+    defformatstring(pname, "%s#p%d", s, pitch);
+    soundsample *ps = samples.access(pname);
+    if(ps && ps->chunk) return;   // already warm
+    soundsample *base = samples.access(s);
+    if(!base)
+    {
+        char *n = newstring(s);
+        base = &samples[n];
+        base->name = n;
+        base->chunk = NULL;
+    }
+    if(!base->chunk && !base->load()) return;
+    Mix_Chunk *rc = resamplechunk(base->chunk, pitch);
+    if(!rc) return;
+    if(!ps)
+    {
+        char *pn = newstring(pname);
+        ps = &samples[pn];
+        ps->name = pn;
+    }
+    ps->chunk = rc;
+}
