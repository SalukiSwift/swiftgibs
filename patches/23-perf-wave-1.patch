+                copystring(r.relpath, job.relpath);
+                r.basems = job.basems; r.lastms = job.lastms;
+                break;
+            }
+            case SGCLIPJOB_RECOPEN:
+            {
+                string mode; formatstring(mode, "wb%d", job.level);
+                gzFile gz = gzopen(job.path, mode);
+                bool ok = gz != NULL;
+                if(ok && job.len) ok = gzwrite(gz, job.buf, (unsigned)job.len) == job.len;
+                if(ok) sgcliprecfiles[job.slot] = gz;
