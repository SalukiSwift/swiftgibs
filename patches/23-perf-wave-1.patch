+                break;
+            }
+            case SGCLIPJOB_RECAPPEND:
+            {
+                gzFile gz = sgcliprecfiles[job.slot];
+                if(gz && job.len) gzwrite(gz, job.buf, (unsigned)job.len);
+                delete[] job.buf;
+                break;
+            }
+            case SGCLIPJOB_RECCLOSE:
+            {
+                gzFile gz = sgcliprecfiles[job.slot];
+                if(gz) { gzclose(gz); sgcliprecfiles[job.slot] = NULL; }
