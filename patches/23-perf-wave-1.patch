+    // path(), findfile() touches homedir) the worker may never call. Operates on up to two
+    // ALREADY-ABSOLUTE directory strings the frame thread resolved before enqueueing (see
+    // finishcliprecorder() below) using nothing but opendir/readdir/remove (or FindFirstFile on
+    // Windows) - no engine call anywhere in this function or sgclipprunescan() below.
+    struct sgclipprunefile { string name, dir; };
+    static void sgclipscandir(const char *dir, vector<sgclipprunefile> &entries)
+    {
+        if(!dir || !dir[0]) return;
+#ifdef WIN32
+        string pattern;
+        formatstring(pattern, "%s\\*.dmo", dir);
+        WIN32_FIND_DATAA fd;
+        HANDLE h = FindFirstFileA(pattern, &fd);
+        if(h == INVALID_HANDLE_VALUE) return;
+        do
+        {
+            size_t n = strlen(fd.cFileName);
+            if(n <= 4 || strcmp(fd.cFileName+n-4, ".dmo")) continue;
+            sgclipprunefile &e = entries.add();
+            copystring(e.name, fd.cFileName, min((size_t)sizeof(e.name), n-3));
+            copystring(e.dir, dir);
+        } while(FindNextFileA(h, &fd));
+        FindClose(h);
