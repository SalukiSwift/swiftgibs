+    static void sgclipprunescan(const char *dir1, const char *dir2, int keep)
+    {
+        if(keep <= 0) return;
+        vector<sgclipprunefile> entries;
+        sgclipscandir(dir1, entries);
+        sgclipscandir(dir2, entries);
