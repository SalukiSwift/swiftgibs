+    // other stat in this file. n<=0 (no real measured window - e.g. sgbenchpacedselftest's
+    // fixture-only run below never opens one) reports 0.00 for both.
+    static void benchcomputeinputgapstats(const float *src, int n, float &maxgap, float &p99gap)
+    {
+        if(n <= 0) { maxgap = 0.0f; p99gap = 0.0f; return; }
+        float *sorted = new float[n];
+        memcpy(sorted, src, n*sizeof(float));
+        quicksort(sorted, n);
+        maxgap = sorted[n-1];
+        p99gap = benchpercentile(sorted, n, 99.0);
+        delete[] sorted;
+    }
