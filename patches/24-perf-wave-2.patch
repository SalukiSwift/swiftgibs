+    // Pacing-specific stats over a captured (or fixture) frame-time array - see the "Pacing
+    // metrics" comment above for the formulas this implements.
+    struct benchpacedstats { float p50, p99, p999, jitterstddev; int late15count, late20count; };
+
+    static void benchcomputepacedstats(const float *src, int n, int capfps, benchpacedstats &out)
+    {
+        float *sorted = new float[n];
+        memcpy(sorted, src, n*sizeof(float));
+        quicksort(sorted, n);
+
+        out.p50  = benchpercentile(sorted, n, 50.0);
+        out.p99  = benchpercentile(sorted, n, 99.0);
+        out.p999 = benchpercentile(sorted, n, 99.9);
+        delete[] sorted;
+
+        double sum = 0;
+        for(int i = 0; i < n; i++) sum += src[i];
+        double mean = sum / n;
+        double sqsum = 0;
+        for(int i = 0; i < n; i++) { double d = src[i] - mean; sqsum += d*d; }
+        out.jitterstddev = sqrtf(float(sqsum / n));
+
+        double period = 1000.0 / double(capfps);
+        int late15 = 0, late20 = 0;
+        for(int i = 0; i < n; i++)
+        {
+            if(src[i] > float(1.5*period)) late15++;
+            if(src[i] > float(2.0*period)) late20++;
+        }
+        out.late15count = late15;
+        out.late20count = late20;
+    }
