+    void benchinputtick()
+    {
+        Uint64 now = SDL_GetPerformanceCounter();
+        static const Uint64 freq = SDL_GetPerformanceFrequency();
+        if(benchlastinputticks)
+        {
+            double gapms = double(now - benchlastinputticks) * 1000.0 / double(freq);
