+    // set via a bare `keepserver name port pass` or an old console /connect, never through
+    // this menu flow at all).
+    const char *pw = getsavedpassword(selectedserver->name, selectedserver->port);
+    if(!pw || !pw[0]) pw = selectedserver->password;
