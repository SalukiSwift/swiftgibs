+// SwiftGibs (patch 20): companion to clearsavedpassword() above, for the OTHER password
+// memory - the stock serverinfo::password field addserver() (just above) unconditionally
+// overwrites on every connect ATTEMPT, success or failure, so it can hold a password that
+// was never confirmed working. Cleared alongside our own store on a DISC_PASSWORD reject so a
+// second consecutive stale password (ours already cleared, stock not) cannot still be
+// silently retried from connectselected()'s fallback.
+void clearstaleserverpassword(const char *name, int port)
+{
+    loopv(servers) if(servers[i]->port == port && !strcmp(servers[i]->name, name)) { DELETEA(servers[i]->password); return; }
+}
