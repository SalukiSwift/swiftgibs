 #include "engine.h"
 
+// === SwiftGibs server favourites + saved passwords (patch 20) ===
+// Two small persisted stores, same shape as the M3 friend list (patches/03-friends.patch):
+// an in-memory vector, ICOMMANDs to add/remove/query an entry, and a writeXXX() that
+// rewrites the whole file on every change. Both are keyed by the server's displayed name
+// + port - the same identity addserver()/servers.cfg already use, not the resolved IP
+// (a hostname entry may not even have one yet).
+//
+// PLAINTEXT WARNING: serverpasswords.cfg stores passwords in plaintext. This is not a new
+// risk this patch introduces - the stock servers.cfg above already does the same for any
+// server ever connected to with a password (see writeservercfg() further down, predates
+// this patch). Anyone with filesystem access to this profile folder can read either file.
+// The server-browser page hints at this (overlay/menus_serverbrowser.cfg).
+struct favouriteserver { string name; int port; };
+vector<favouriteserver> favourites;
+
+bool isfavourite(const char *name, int port)
+{
+    loopv(favourites) if(favourites[i].port == port && !strcmp(favourites[i].name, name)) return true;
+    return false;
+}
+
+void writefavourites()
+{
+    stream *f = openutf8file(path("favourites.cfg", true), "w");
+    if(!f) return;
+    f->printf("// SwiftGibs favourite servers - starred rows float to the top with a gold highlight\n\n");
+    loopv(favourites) f->printf("addfavourite %s %d\n", escapeid(favourites[i].name), favourites[i].port);
+    delete f;
+}
+
+void addfavourite(const char *name, int port)
+{
+    if(isfavourite(name, port)) return;
+    favouriteserver &fs = favourites.add();
+    copystring(fs.name, name);
+    fs.port = port;
+    writefavourites();
+}
+
+void delfavourite(const char *name, int port)
+{
+    loopv(favourites) if(favourites[i].port == port && !strcmp(favourites[i].name, name))
+    {
+        favourites.remove(i);
+        writefavourites();
+        return;
+    }
+}
+
+void togglefavourite(const char *name, int port)
+{
+    if(isfavourite(name, port)) delfavourite(name, port);
+    else addfavourite(name, port);
+}
+
+ICOMMAND(addfavourite, "si", (const char *name, int *port), addfavourite(name, *port));
+ICOMMAND(delfavourite, "si", (const char *name, int *port), delfavourite(name, *port));
+ICOMMAND(isfavourite, "si", (const char *name, int *port), intret(isfavourite(name, *port) ? 1 : 0));
+
+struct savedserverpass { string name, pass; int port; };
+vector<savedserverpass> savedpasswords;
+
+const char *getsavedpassword(const char *name, int port)
+{
+    loopv(savedpasswords) if(savedpasswords[i].port == port && !strcmp(savedpasswords[i].name, name)) return savedpasswords[i].pass;
+    return NULL;
+}
+
+void writesavedpasswords()
+{
+    stream *f = openutf8file(path("serverpasswords.cfg", true), "w");
+    if(!f) return;
+    f->printf("// SwiftGibs saved server passwords - stored in PLAINTEXT, same as the stock\n"
+               "// servers.cfg password field above. Anyone with access to this profile folder\n"
+               "// can read these. Only servers you successfully joined from the menu with a\n"
+               "// password get an entry; a rejected (stale) password is removed, not kept.\n\n");
+    loopv(savedpasswords) f->printf("addsavedpassword %s %d %s\n", escapeid(savedpasswords[i].name), savedpasswords[i].port, escapestring(savedpasswords[i].pass));
+    delete f;
+}
+
+void setsavedpassword(const char *name, int port, const char *pass)
+{
+    if(!name || !name[0] || !pass || !pass[0]) return;
+    loopv(savedpasswords) if(savedpasswords[i].port == port && !strcmp(savedpasswords[i].name, name))
+    {
+        if(!strcmp(savedpasswords[i].pass, pass)) return;
+        copystring(savedpasswords[i].pass, pass);
+        writesavedpasswords();
+        return;
+    }
+    savedserverpass &sp = savedpasswords.add();
+    copystring(sp.name, name);
+    sp.port = port;
+    copystring(sp.pass, pass);
+    writesavedpasswords();
+}
+
+void clearsavedpassword(const char *name, int port)
+{
+    loopv(savedpasswords) if(savedpasswords[i].port == port && !strcmp(savedpasswords[i].name, name))
+    {
+        savedpasswords.remove(i);
+        writesavedpasswords();
+        return;
+    }
+}
+
+// addsavedpassword is also how serverpasswords.cfg loads itself back in at startup
+// (exec'd from autoexec.cfg) - setsavedpassword() dedupes/rewrites either way.
+ICOMMAND(addsavedpassword, "sis", (const char *name, int *port, const char *pass), setsavedpassword(name, *port, pass));
+
+// Password-prompt UI state (transient, never persisted - overlay/menus_serverbrowser.cfg's
+// "sgpasswordprompt" is its OWN dialog gui that reads these; see triggerpasswordprompt()).
+SVAR(sgpwpromptserver, "");
+VAR(sgpwpromptport, 0, 0, 0xFFFF);
+VAR(sgpwpromptactive, 0, 0, 1);
+SVAR(sgpwpromptvalue, "");
+
+// Field-fix round 2 (item 4, final-review M3): a single, authoritative reset for the
+// transient prompt state, called on every path that should invalidate an outstanding or
+// stale prompt - cancel (below) and a successful join (fpsgame/client.cpp's N_WELCOME).
+// A brand new connectserv() attempt (engine/client.cpp) clears just the int flag inline
+// instead of calling this - not a heap-owned SVar, so it is always safe to touch even while
+// another local still holds a copy of the current name/value, and clearing only the flag
+// (not the server/port identity) avoids a one-frame blank "password for :0" flash while a
+// submitted attempt from THIS SAME dialog is still resolving.
+void resetpasswordprompt()
+{
+    setsvar("sgpwpromptserver", "");
+    setvar("sgpwpromptport", 0);
+    setvar("sgpwpromptactive", 0);
+    setsvar("sgpwpromptvalue", "");
+}
+
+void triggerpasswordprompt(const char *name, int port, const char *prefill)
+{
+    setsvar("sgpwpromptserver", name);
+    setvar("sgpwpromptport", port);
+    setsvar("sgpwpromptvalue", prefill && prefill[0] ? prefill : "");
+    setvar("sgpwpromptactive", 1);
+    // Found via live harness testing: a menu-initiated connect can get rejected while the
+    // player is not even looking at the server-browser page (disconnect() always drops back
+    // to whatever gui/mainmenu state was active). Force that page open so there is a sensible
+    // page behind the dialog (and so a screenshot taken while the dialog is up can confirm the
+    // browser panel itself did not change size), then stack the dialog - its own separate
+    // "sgpasswordprompt" gui (field-fix round 2, item 3) - on top of it. Never rows injected
+    // into "servers" any more; that was the original design and the field-reported cause of
+    // the browser panel changing size whenever this box appeared or disappeared.
+    showgui("servers");
+    showgui("sgpasswordprompt");
+}
+
+// SwiftGibs width-fix (2026-08-10): promptserverpassword(), the "pw.." row-action
+// wrapper around triggerpasswordprompt() below, is deliberately removed - a spec
+// deviation from the original QoL batch item 7. It was the only caller of
+// triggerpasswordprompt() other than the DISC_PASSWORD intercept in
+// engine/client.cpp, which already opens the identical prompt the first time a
+// row click on a passworded server fails (one attempt, then the box) - so the
+// extra "pw.." column was redundant, and it was a direct contributor to the
+// reported menu-shrink regression (fpsgame/fps.cpp's serverinfoentry lost its
+// case 10). triggerpasswordprompt() itself, and everything it feeds, is unchanged.
+
+ICOMMAND(sgconnectwithprompt, "", (),
+{
+    // Field-fix round 2 (item 4): copy out to locals FIRST - connectserv() clears
+    // sgpwpromptactive at its own top (see there) as part of "any new connect attempt
+    // invalidates a stale prompt", and the plaintext value is cleared here immediately after
+    // copying it (same "cleared before the network result is known" property as before) - if
+    // the raw SVar pointers were passed straight through instead, clearing them would free
+    // memory connectserv() is still using for this very call.
+    if(sgpwpromptserver[0])
+    {
+        string server;
+        string pass;
+        copystring(server, sgpwpromptserver);
+        int port = sgpwpromptport;
+        copystring(pass, sgpwpromptvalue);
+        setsvar("sgpwpromptvalue", "");
+        connectserv(server, port, pass, true);
+    }
+});
+
+ICOMMAND(sgcancelpwprompt, "", (), resetpasswordprompt());
+
