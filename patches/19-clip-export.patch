+// engine/processpipe.h: controlled child-process launch with a writable
+// pipe to the child's stdin.
+//
+// This is the one and only way SwiftGibs is allowed to run an external
+// program (the bundled ffmpeg, for clip video export - see
+// docs/superpowers/specs/2026-07-30-clip-video-export-design.md). It exists
+// so ffmpeg can be run as a wholly separate process rather than linked into
+// the engine: SwiftGibs is zlib licensed and ffmpeg's H.264 encoder is
+// typically GPL, so linking would force the engine binary itself to GPL.
+// Running it as a child process fed by a pipe is mere aggregation and keeps
+// the two licences apart. Do NOT add an alternate path that shells out or
+// links an encoder library - this file is the load-bearing boundary.
+//
+// The caller always assembles a fixed, NULL-terminated argument vector
+// itself. Nothing in here goes through a shell (no popen, no system()), so
+// there is no command string to mis-tokenise or inject into - argv[0] is
+// the exact program to run and argv[1..] are passed to it verbatim.
+
+#ifndef __PROCESSPIPE_H__
+#define __PROCESSPIPE_H__
+
+// Forward declaration of killprocesspipe (full doc comment is with the
+// other three functions below) so that processpipe's own destructor -
+// defence in depth for callers with many exit paths (cancellation,
+// failure, clip-end) that might forget to close explicitly - can call it.
+// Kept as a plain forward declaration rather than reordering the whole
+// file so the four operations stay documented together, in the order a
+// caller uses them.
+struct processpipe;
+extern void killprocesspipe(processpipe &p);
+
+struct processpipe
+{
+#ifdef WIN32
+    void *process;   // HANDLE (kept as void* so this header doesn't need windows.h)
+    void *writepipe; // HANDLE
+#else
+    int pid;
+    int writefd;
+#endif
+    bool isopen;
+
+    processpipe() :
+#ifdef WIN32
+        process(NULL), writepipe(NULL),
+#else
+        pid(-1), writefd(-1),
+#endif
+        isopen(false)
+    {}
+
+    // RAII backstop: if a caller's processpipe goes out of scope still
+    // open (an exception-free codebase, but there are still plenty of
+    // early-return exit paths - failure, cancellation, a clip ending
+    // early), force-close/reap rather than leaking the fd/handle and
+    // orphaning the child. This is a backstop, not licence to skip the
+    // explicit closeprocesspipe()/killprocesspipe() call on the normal
+    // path - it forcibly kills rather than giving ffmpeg a chance to
+    // finish writing its output cleanly.
+    ~processpipe() { if(isopen) killprocesspipe(*this); }
+
+    // Resets to the same just-constructed (not-open) state. Used
+    // internally by openprocesspipe() instead of the old "p =
+    // processpipe()" idiom, now that processpipe cannot be copied (see
+    // below) - a byte-for-byte copy would leave two structs both believing
+    // they own the same fd/handle, risking a double-close or double-reap
+    // of the same child.
+    void clear()
+    {
+#ifdef WIN32
+        process = NULL; writepipe = NULL;
+#else
+        pid = -1; writefd = -1;
+#endif
+        isopen = false;
+    }
+
+private:
+    // Noncopyable (pre-C++11 style: declared, never defined). Same
+    // reasoning as the destructor comment above - copying would duplicate
+    // ownership of one fd/handle across two live structs.
+    processpipe(const processpipe &);
+    processpipe &operator=(const processpipe &);
+};
+
+// Spawns argv[0] with arguments argv[1..], connecting its standard input to
+// a pipe this process can write to. argv must be NULL-terminated; argv[0]
+// is an exact path, never searched via a shell or PATH-parsed command
+// string. Returns false (and leaks nothing - all handles/descriptors this
+// call created are cleaned up) if the pipe couldn't be created or the
+// child couldn't be launched at all.
+//
+// p must not already be open. In a debug build (_DEBUG) that is an
+// immediate ASSERT abort - reusing a struct for a new child without
+// closing the old one first is a caller bug, and process teardown on abort
+// still closes the leaked fd/handle and lets the orphaned child see EOF
+// and exit on its own, so even the crash path doesn't leave a hung
+// process behind. In a release build (where ASSERT is a no-op and
+// execution continues past it) this instead force-closes/reaps whatever
+// was already there before proceeding, so a caller mistake here still
+// leaks nothing and orphans nothing outside a debug build - but the
+// correct sequence is always closeprocesspipe() or killprocesspipe()
+// before reopening; don't rely on either backstop.
+extern bool openprocesspipe(processpipe &p, const char *const *argv);
+
+// Writes len bytes to the child's stdin, retrying on partial writes.
+// Returns false if the child has gone away (its end of the pipe is
+// closed/broken) or any other write error occurs; this is a normal,
+// checked failure the caller should treat as an export error - it can
+// never crash the game (SIGPIPE, where it exists, is ignored).
+//
+// BLOCKING CONTRACT: this is a plain blocking write (blocking fd write() on
+// POSIX, synchronous non-overlapped WriteFile() on Windows - no
+// O_NONBLOCK, no overlapped IO anywhere in this file). If the pipe is full
+// because the child is reading slower than this writes, the CALLING THREAD
+// blocks until the child drains it or the child dies (at which point this
+// returns false rather than blocking forever). It never partially
+// "succeeds" under backpressure and never fails just because the pipe is
+// momentarily full - backpressure is absorbed by blocking, not reported as
+// an error. Consequently: never call this from a thread that must stay
+// responsive (the main/render thread) - only from a thread that is allowed
+// to stall waiting for a slow or stuck consumer. Callers that need smooth
+// producer-side behaviour under a slow consumer must implement their own
+// drop-when-full queue upstream of this call, on a separate thread; this
+// function itself provides no non-blocking or dropping mode.
+extern bool writeprocesspipe(processpipe &p, const void *data, size_t len);
+
+// Closes the write end of the pipe (so the child sees EOF on stdin), waits
+// for the child to exit, and returns its exit status (0 = success). Always
+// reaps the child and releases every handle/descriptor this facility holds,
+// even if the child already died or the pipe was already broken. Returns
+// -1 if the exit status could not be determined (e.g. the child was killed
+// by a signal). Safe to call on a pipe that was never successfully opened,
+// or more than once - the second call is a no-op returning -1.
+extern int closeprocesspipe(processpipe &p);
+
+// Cancellation path: closes the pipe and forcibly terminates the child
+// (SIGKILL / TerminateProcess) instead of waiting for it to exit on its
+// own, then reaps it so no zombie/orphan is left behind. Use this instead
+// of closeprocesspipe() when aborting an export; safe to call on a pipe
+// that isn't open.
+extern void killprocesspipe(processpipe &p);
+
+#endif
