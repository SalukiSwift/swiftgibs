+    //   - WHILE FINISHING (after we've closed our end and are waiting for ffmpeg to drain+exit):
+    //     the heartbeat necessarily stops advancing on its own (no more frames are ever coming),
+    //     so this phase uses a plain absolute deadline instead - clipexportwdfinishing/
+    //     clipexportwdfinishdeadline, set by the finishing code right before it calls
+    //     recorder::stop()/closeprocesspipe(), giving a fresh clipexportfinishtimeout-second
+    //     grace window rather than inheriting a stale "last write was N seconds ago" reading
+    //     from the moment capture stopped.
+    // Reading clipexportpipe.pid/.process here (via requestchildkill(), which touches nothing
+    // else) is safe without a lock: it's written once by openprocesspipe(), on the main thread,
+    // strictly BEFORE this thread is created (thread creation is itself a synchronisation point),
+    // and never mutated again by the owning thread until AFTER this thread has been joined
+    // (clipexportstopwatchdog(), called only after recorder::stop()+closeprocesspipe()/
+    // killprocesspipe() have already finished) - so there is no window where both a reap and a
+    // read of the same fields can be in flight at once.
+    static SDL_Thread *clipexportwatchdog = NULL;
+    static volatile bool clipexportwdstop = false;
+    static volatile bool clipexportwdfinishing = false;
+    static volatile int clipexportwdfinishdeadline = 0;
+    static volatile bool clipexportwdfired = false; // did the watchdog actually have to intervene? (surfaced in the finish/abort console message)
+
+    static int clipexportwatchdogthread(void *)
+    {
+        uint lastframes = 0;
+        int lastprogress = (int)SDL_GetTicks();
+        for(;;)
+        {
+            SDL_Delay(250);
+            if(clipexportwdstop) break;
+            if(clipexportwdfinishing)
+            {
+                if((int)SDL_GetTicks() - clipexportwdfinishdeadline >= 0)
+                {
+                    requestchildkill(clipexportpipe);
+                    recorder::requestpipecancel();
+                    clipexportwdfired = true;
+                    break;
+                }
+                continue;
+            }
+            uint frames = recorder::exportframessofar();
+            if(frames != lastframes) { lastframes = frames; lastprogress = (int)SDL_GetTicks(); }
+            if((int)SDL_GetTicks() - lastprogress > clipexportstalltimeout*1000)
+            {
+                requestchildkill(clipexportpipe);
+                recorder::requestpipecancel();
+                clipexportwdfired = true;
+                break;
+            }
+        }
+        return 0;
+    }
+
+    static void clipexportstopwatchdog()
+    {
+        if(!clipexportwatchdog) return;
+        clipexportwdstop = true;
+        SDL_WaitThread(clipexportwatchdog, NULL);
+        clipexportwatchdog = NULL;
+    }
+
+    // Deletes an incomplete/cancelled output rather than leaving a half file that looks like a
+    // finished video. Never touches anything else (in particular, never the source clip - this
+    // only ever operates on clipexportoutpath, which is always inside videodir). Safe if nothing
+    // was ever written (ffmpeg failed to launch, or we never got as far as opening the pipe) -
+    // remove() on a path that doesn't exist is a harmless, silent failure here, not reported.
+    static void clipexportremoveoutput()
+    {
+        if(!clipexportoutpath[0]) return;
+        remove(findfile(clipexportoutpath, "w"));
+    }
+
+    // Deletes this export's two possible temp intermediates - the small, already-compressed
+    // video-only file and the small WAV audio file the two-ffmpeg-pass audio design uses (see
+    // clipexportsoundenabled/clipexporttmpvideopath/clipexporttmpwavpath above and
+    // clipexportonplaybackend() below) - if they exist. Called unconditionally on every exit path
+    // (success or failure), regardless of whether sound was actually enabled for THIS export:
+    // remove() on a path that was never created (the sound-disabled case, where pass 1 writes
+    // straight to clipexportoutpath as it always has) is the same harmless no-op
+    // clipexportremoveoutput() above already relies on. Never touches clipexportoutpath itself.
+    static void clipexportremovetempfiles()
+    {
+        if(clipexporttmpvideopath[0]) remove(findfile(clipexporttmpvideopath, "w"));
+        if(clipexporttmpwavpath[0]) remove(findfile(clipexporttmpwavpath, "w"));
+    }
+
+    // The single non-success teardown path: cancellation, failure, a WAITING-phase timeout,
+    // disconnect/quit, or an unexpected map change mid-export. Always: re-arms the watchdog's
+    // grace window then kills the child directly ourselves too (faster than waiting for the
+    // watchdog's next 250ms poll), stops+reaps everything, deletes the incomplete output file,
+    // and restores every setting this export touched. Idempotent (a second call finds phase
+    // already IDLE and returns) and safe to call from ANY phase including IDLE, which is what
+    // lets gamedisconnect() and startgame()'s hooks call it unconditionally without needing to
+    // know whether an export is even running.
+    void clipexportabort(const char *reason)
+    {
+        if(clipexportphase == CLIPEXPORT_IDLE) return;
+        clipexportphase = CLIPEXPORT_IDLE;
+
+        // Kill first, THEN stop(): ffmpeg's health is unknown on most paths that reach this
+        // function (that is usually WHY we're here) - never call a bare recorder::stop() first,
+        // since its SDL_WaitThread would hang the CALLER (not just the watchdog) if the encoder
+        // thread were still blocked inside a wedged writeprocesspipe(). Re-arming the watchdog's
+        // finishing deadline here too means even if this direct kill somehow doesn't land (pid
+        // already reused, freak timing), the watchdog is still independently counting down as a
+        // backstop for the stop()/closeprocesspipe() calls below.
+        clipexportwdfinishing = true;
+        clipexportwdfinishdeadline = (int)SDL_GetTicks() + clipexportfinishtimeout*1000;
+        requestchildkill(clipexportpipe);
+        recorder::requestpipecancel();
+
+        recorder::stop();                  // safe now: the child is already dying/dead, so the encoder thread's blocked write (if any) resolves promptly
+        clipexportstopwatchdog();          // join; fast, since whatever the watchdog was guarding against is already resolved by this point
+        killprocesspipe(clipexportpipe);   // finish reaping our own pipe/child bookkeeping - safe now nothing else touches it
+
+        clipexportremoveoutput();
+        clipexportremovetempfiles();
+        clipexportrestoresettings();
+
+        conoutf("clip export stopped: %s", reason);
+
+        // Auto-return (Task: auto-return after export): every non-cancellation abort leaves the
+        // replay and returns to the main menu one frame from now (see clipexportpendingreturn's
+        // own doc comment, above, for why this is deferred rather than acted on right here) -
+        // "cancelled" is the one reason string this feature itself never changes the handling
+        // of, since that is ESC/cancelclipexport's own existing behaviour (overlay/autoexec.cfg's
+        // sgCancelExport already leaves the replay via its own stopdemo call immediately after
+        // this function returns, at the CubeScript layer - adding a second, deferred one here
+        // too would be redundant, not incorrect, but the design explicitly keeps that path
+        // unchanged).
+        if(strcmp(reason, "cancelled")) clipexportpendingreturn = true;
+    }
+
+    // Called from case N_DEMOPLAYBACK's on==0 branch (above) - the clip's own NATURAL end
+    // (including running out early on a truncated/corrupt .dmo - either way this is "the clip's
+    // own content decided playback is over", not an external interruption). No-op if no export
+    // is in progress or capture hadn't actually started yet (a demoend before players[1] was
+    // even identified means something went wrong loading the clip, not a real export to finish -
+    // routed to the same abort/cleanup path with an explanatory reason).
+    //
+    // Audio (this task): when clipexportsoundenabled, pass 1 (above, in checkclipexport()) wrote
+    // a small ALREADY-COMPRESSED video-only file to clipexporttmpvideopath rather than straight to
+    // clipexportoutpath, and engine/movie.cpp's pipewriter captured the game's own audio into
+    // clipexporttmpwavpath alongside it. Once pass 1 has cleanly finished (below), a SECOND, fast
+    // ffmpeg pass muxes those two small intermediates - `-c:v copy` (no video re-encode at all,
+    // just remux) plus an audio encode of the small WAV - into the real clipexportoutpath. When
+    // sound is disabled, none of this runs: pass 1 already wrote directly to clipexportoutpath,
+    // exactly as before this task.
+    void clipexportonplaybackend()
+    {
+        if(clipexportphase == CLIPEXPORT_IDLE) return;
+        if(clipexportphase != CLIPEXPORT_CAPTURING) { clipexportabort("clip ended before capture began"); return; }
+        clipexportphase = CLIPEXPORT_IDLE;
+
+        clipexportwdfinishing = true;
+        clipexportwdfinishdeadline = (int)SDL_GetTicks() + clipexportfinishtimeout*1000;
+
+        recorder::stop();                                       // encoder finishes delivering whatever's already queued (video AND sound - see pipewriter::writesound()), then its thread exits; DELETEP(file) inside stop() also finalises + closes the WAV temp file's header (pipewriter's destructor)
+
+        // CRITICAL review fix (Task 4): the watchdog must stay ALIVE across this next call.
+        // closeprocesspipe() does a plain blocking waitpid() with no timeout of its own, waiting
+        // for ffmpeg to exit after seeing EOF. If ffmpeg accepts every frame normally but never
+        // exits, this hangs the MAIN THREAD forever - freezing the whole game (no UI left to
+        // cancel from) with clipexportrestoresettings() below never reached. Empirically
+        // reproduced by review with a fake ffmpeg that reads all stdin then sleeps: stopping the
+        // watchdog BEFORE this call (the original bug here) disarms exactly the mechanism meant
+        // to catch it. clipexportwdfinishing/clipexportwdfinishdeadline are already armed above
+        // (set the moment capture ended, before recorder::stop()) - if the deadline passes while
+        // this call is still blocked in waitpid(), the still-running watchdog thread calls
+        // requestchildkill() to force the child to exit, unblocking the wait, exactly like the
+        // WAITING-phase and stalled-capture cases already do. (This does mean
+        // requestchildkill()'s read of clipexportpipe.pid can race with this call's own eventual
+        // write of clipexportpipe.pid=-1 once the reap completes - an unsynchronised read/write
+        // of a plain int, same accepted-risk category as this codebase's other cross-thread
+        // flags; worst case is a redundant/no-op signal, not a crash. See processpipe.h's own
+        // doc comment on requestchildkill() for the general reasoning this leans on, and for the
+        // SAME pattern being deliberately repeated a second time below for the mux pass.)
+        int exitcode = closeprocesspipe(clipexportpipe);         // close our end (ffmpeg sees EOF), wait for it to finish encoding and exit, reap it - the STILL-RUNNING watchdog is what actually bounds this wait, not this call itself
+        bool pass1failed = (exitcode != 0 || clipexportwdfired);
+
+        // Pass 2: mux audio in, only if pass 1 succeeded cleanly and this export actually wanted
+        // sound. The watchdog is DELIBERATELY kept alive across this second blocking wait too
+        // (not stopped and restarted) - for the exact same reason the critical fix above keeps it
+        // alive across the first: closeprocesspipe() here has no timeout of its own either, and a
+        // mux ffmpeg that hangs would otherwise freeze the main thread with nothing left to
+        // rescue it. Reusing clipexportpipe (already closed and reaped by the line above, so
+        // openprocesspipe() below is reopening a non-open struct - the ordinary supported case)
+        // for this second child is what lets the watchdog thread's own code (which only ever
+        // reads clipexportpipe.pid/.process, completely unchanged since Task 3) protect this new
+        // phase with ZERO changes to the watchdog thread itself.
+        bool muxattempted = false, muxfailed = false, wdfiredmux = false;
+        int muxexitcode = 0;
+        if(!pass1failed && clipexportsoundenabled)
+        {
+            muxattempted = true;
+            clipexportwdfired = false; // fresh flag for this second wait - pass 1's is already consumed above (pass1failed)
+            clipexportwdfinishdeadline = (int)SDL_GetTicks() + clipexportmuxtimeout*1000;
+
+            // findfile() returns a pointer into its own single static scratch buffer - resolving
+            // three paths here (final output, tmp video, tmp wav) needs each copied out
+            // immediately, same fix and same reasoning as checkclipexport()'s pass 1 argv build
+            // above (found by the same test failure: ffmpeg's inputs pointed at the wrong path
+            // until this was fixed).
+            string resolvedfinal, resolvedtmpvideo, resolvedtmpwav;
+            copystring(resolvedfinal, findfile(clipexportoutpath, "w"));
+            copystring(resolvedtmpvideo, findfile(clipexporttmpvideopath, "w"));
+            copystring(resolvedtmpwav, findfile(clipexporttmpwavpath, "w"));
+            // QoL batch (lossless export): clipexportlosslessenabled (snapshotted at exportclip()
+            // time, like the sound flag itself) takes priority over the webm/mp4 format choice -
+            // a lossless export's container is always matroska (clipexportext was set to "mkv" by
+            // exportclip() whenever this is true), so webm here is forced false rather than ever
+            // re-deriving it from clipexportext, keeping the two mutually exclusive.
+            bool lossless = clipexportlosslessenabled;
+            bool webm = !lossless && !strcmp(clipexportext, "webm");
+            const char *argv[24]; // needs 21 slots at most (mp4 branch: 18 fixed + -shortest + output + NULL; the lossless branch below is smaller still) - sized with headroom, matching pass 1's own argv[32] convention
+            int argc = 0;
+            argv[argc++] = clipexportffmpegpath;
+            argv[argc++] = "-y";
+            argv[argc++] = "-hide_banner";
+            argv[argc++] = "-loglevel"; argv[argc++] = "error";
+            argv[argc++] = "-nostats";
+            argv[argc++] = "-i"; argv[argc++] = resolvedtmpvideo;
+            argv[argc++] = "-i"; argv[argc++] = resolvedtmpwav;
+            argv[argc++] = "-c:v"; argv[argc++] = "copy"; // pass 1 already encoded the video - never re-encode it here, this pass only adds audio
+            if(lossless)
+            {
+                // flac: matroska's own native lossless audio codec - matches the video codec's
+                // own honesty (a "lossless export" whose audio pass silently reached for a lossy
+                // codec would undercut the label), confirmed present in the bundled ffmpeg's own
+                // -encoders listing alongside ffv1 (see this task's own report).
+                argv[argc++] = "-c:a"; argv[argc++] = "flac";
+            }
+            else if(webm)
+            {
+                argv[argc++] = "-c:a"; argv[argc++] = "libopus"; // royalty-free, matching the design doc's own reasoning for offering WebM/VP9 at all
+            }
+            else
+            {
+                argv[argc++] = "-c:a"; argv[argc++] = "aac"; argv[argc++] = "-b:a"; argv[argc++] = "160k";
+                argv[argc++] = "-movflags"; argv[argc++] = "+faststart"; // mov/mp4-muxer-only option - matches pass 1's own mp4 flag; deliberately NOT reached for the matroska (lossless) branch above, which has no use for it
+            }
+            argv[argc++] = "-shortest"; // safety net for a marginal (sub-frame-in-practice) tail-length mismatch between the two independently-captured streams, not a sync fix - see ce-task-5b-report.md's measured offset
+            argv[argc++] = resolvedfinal;
+            argv[argc++] = NULL;
+
+            if(!openprocesspipe(clipexportpipe, argv))
+            {
+                muxfailed = true;
+                muxexitcode = -1;
+            }
+            else
+            {
+                muxexitcode = closeprocesspipe(clipexportpipe);
+                wdfiredmux = clipexportwdfired;
+                if(muxexitcode != 0 || wdfiredmux) muxfailed = true;
+            }
+        }
+
+        clipexportstopwatchdog(); // NOW join - after every blocking wait this export will ever do (pass 1's close above, and pass 2's mux close if it ran)
+
+        clipexportremovetempfiles(); // the two small intermediates are never the deliverable - always cleaned up regardless of outcome
+        clipexportrestoresettings();
+
+        bool ok = !pass1failed && (!clipexportsoundenabled || (muxattempted && !muxfailed));
+        if(ok)
+        {
+            // Auto-return (Task: auto-return after export): "exported: <filename>" is the exact
+            // line the design doc specifies for a successful export - replaces the previous
+            // "clip exported: %s" wording.
+            conoutf("exported: %s", clipexportoutpath);
+        }
+        else if(muxattempted)
+        {
+            conoutf(CON_ERROR, "exportclip: audio mux failed (%d)%s - output removed", muxexitcode,
+                    wdfiredmux ? ", had to be force-stopped" : "");
+            clipexportremoveoutput();
+        }
+        else
+        {
+            conoutf(CON_ERROR, "exportclip: ffmpeg exited abnormally (%d)%s - output removed", exitcode,
+                    clipexportwdfired ? ", had to be force-stopped" : "");
+            clipexportremoveoutput();
+        }
+
+        // Auto-return (Task: auto-return after export): success AND failure both leave the
+        // replay and return to the main menu one frame from now - see clipexportpendingreturn's
+        // own doc comment for why this is deferred, and why this function (unlike
+        // clipexportabort()) never needs a "cancelled" exclusion: reaching this function at all
+        // already means capture was never cancelled (cancellation always goes through
+        // clipexportabort("cancelled") instead, never here).
+        clipexportpendingreturn = true;
+    }
+
+    // startgame() interruption guard (called unconditionally from fpsgame/fps.cpp) - only acts
+    // if a capture was already under way. The export's OWN initial map load into the clip being
+    // exported also arrives here via changemapserv() like any other map change, but that
+    // happens while phase is still WAITING (before capture starts), so it is correctly ignored;
+    // this only fires for a map change that has no business happening mid-capture.
+    //
+    // FIELD FIX (April's nucleus clip, 2026-08-07 - the export that produced no video at all):
+    // a map change that arrives DURING demo playback IS the clip's own recorded content, and it
+    // has every business happening. A clip is a slice of a real recorded session, and a real
+    // session changes map inside that slice whenever the server rotates or restarts a match, or
+    // whenever the player reconnects to it. Her clip caught exactly that: a genuine
+    // N_WELCOME + N_MAPCHANGE 29.97s into a 76.9s clip, with the entire 47s of actual gameplay
+    // AFTER it. Aborting there threw the whole export away - no output file, both temp
+    // intermediates created and then deleted - which is what she saw. The same clip exports end
+    // to end once this stops aborting; capture simply continues through the reload.
+    //
+    // Two things that could have made continuing wrong are already handled, and were confirmed
+    // on a real export of that clip rather than assumed:
+    //   - No loading-screen frame can leak into the video. Under an export the output frame
+    //     number comes from detframe, which only ever advances in the main loop's own frame step
+    //     (engine/movie.cpp deterministicframestep()/readbuffer()), so the extra swapbuffers()
+    //     calls renderprogress() makes while the map loads cannot claim a new output frame. The
+    //     gap is filled by the writer's existing duplicate padding instead - measured as 64
+    //     duplicated frames across the reload, and the frames either side of it are real world.
+    //   - Audio and video stay in step. The pacer's per-iteration catch-up repays the blocked
+    //     load quickly (measured: 76.550s of video against 76.579s of live-captured audio, 29ms
+    //     apart over a clip with a full map reload in the middle).
+    // The pre-round-5 build (67249e3) aborts on this same clip at the same instant, so this is a
+    // long-standing limit of the export rather than anything the round-5 playback rework did.
+    //
+    // The guard is KEPT for what it was actually written to catch: a map change with no demo
+    // playback behind it, i.e. something outside the clip moved the world mid-capture. That
+    // still aborts exactly as before.
+    void clipexportonmapchange()
+    {
+        if(clipexportphase != CLIPEXPORT_CAPTURING) return;
+        // logoutf, not conoutf - the established pattern in this feature for a note that must
+        // not reach the on-screen console feed the video itself captures.
+        if(demoplayback) { logoutf("clip export: the clip changes map partway through - continuing the capture across it"); return; }
+        clipexportabort("map changed during export");
+    }
+
+    // Ensure `dir` (a virtual/relative directory path in the same "/"-joined convention as
+    // videodir/clipdir/screenshotdir - never a raw OS path) genuinely exists on disk, creating
+    // it if necessary, and reporting the real resolved path on failure.
+    //
+    // WINDOWS BUG THIS WORKS AROUND (root-caused via a standalone harness that forces
+    // PATHDIV='\\' through the actual findfile()/path() logic, plus April's real installed
+    // bundle: see ce-winfix-report.md for the full trace and proof): every directory var in
+    // this codebase is joined onto a filename with a literal '/', by hand, never passed
+    // through path() first. findfile()'s OWN intermediate-directory-creation loop
+    // (shared/stream.cpp) only ever recognises PATHDIV ('\\' on Windows, '/' everywhere else)
+    // as a component separator. On Linux/macOS PATHDIV IS '/', so a literal-'/'-joined path
+    // already matches what that loop looks for, and it silently does the right thing - this is
+    // exactly why this feature "worked in the Linux harness". On Windows PATHDIV is '\\', so
+    // findfile() never even attempts to create the FINAL '/'-joined directory component (it
+    // only ever walks components already separated by a literal '\\' - i.e. homedir's own,
+    // pre-existing, directories) - videodir's own top-level folder was simply never created,
+    // so the first write into it (the sound temp file, or the video pipe target) failed
+    // outright. saveclip() already avoids this by calling path(relpath, true) on its FULL path
+    // before ever reaching findfile() - which is exactly why a real installed bundle can have a
+    // working clips/ folder (auto-created) but no videos/ folder at all the first time export
+    // is used. This function applies the same path() normalisation, but to the directory alone,
+    // up front, so every candidate filename clipexportuniquepath() builds below is guaranteed
+    // to land in a directory that actually exists - independent of, and without touching, the
+    // filename-building/dot-prefix logic further down in exportclip().
+    static bool clipexportensuredir(const char *dir)
+    {
+        if(!dir[0]) return true; // empty videodir means "current directory" - always exists
+        defformatstring(dirslash, "%s/", dir);
+        path(dirslash); // normalise "/" -> PATHDIV so findfile()'s own splitting loop actually reaches this component
+        const char *resolved = findfile(dirslash, "w");
+        string resolveddir;
+        copystring(resolveddir, resolved);
+        size_t rlen = strlen(resolveddir);
+        if(rlen && (resolveddir[rlen-1]=='/' || resolveddir[rlen-1]=='\\')) resolveddir[rlen-1] = '\0';
+        if(!fileexists(resolveddir, "d") && !createdir(resolveddir))
+        {
+            conoutf(CON_ERROR, "exportclip: could not create output folder %s", resolveddir);
+            return false;
+        }
+        return true;
+    }
+
+    // Derives videos/<clip-basename>.<ext>, sanitised the same way clip filenames themselves
+    // are (clipsanitize(), above). Collision policy: never silently overwrite a previous export
+    // of the same clip - try the plain name first, then -2, -3, ... up to 999, and use the
+    // first one that doesn't already exist. Requires the caller to have already ensured
+    // videodir exists (clipexportensuredir(), above) - findfile(...,"w")'s own on-demand
+    // directory creation is not relied on here (see that function's comment for why).
+    static bool clipexportuniquepath(const char *base, const char *ext, char *dst, int dstsize)
+    {
+        loopi(1000)
+        {
+            if(i == 0) nformatstring(dst, dstsize, "%s%s%s.%s", videodir, videodir[0] ? "/" : "", base, ext);
+            else nformatstring(dst, dstsize, "%s%s%s-%d.%s", videodir, videodir[0] ? "/" : "", base, i+1, ext);
+            if(!fileexists(findfile(dst, "w"), "r")) return true;
+        }
+        return false;
+    }
+
+    // Per-frame state machine driver, called unconditionally from fpsgame/fps.cpp's
+    // updateworld() (see the comment there for why it must be unconditional, not gated on
+    // c2sinfo()/connected). A single int compare when idle.
+    void checkclipexport()
+    {
+        // Auto-return (Task: auto-return after export): the deferred half of
+        // clipexportabort()/clipexportonplaybackend() - see clipexportpendingreturn's own doc
+        // comment for why this can never run synchronously inside either of those. localdisconnect()
+        // (extern'd in shared/iengine.h) is the LOCAL-session equivalent of the stock `disconnect`
+        // command: it ends any still-running m_demo playback (server::localdisconnect()'s own
+        // "if(m_demo) enddemoplayback()"), calls game::gamedisconnect() (a safe no-op here as far
+        // as export state goes - clipexportphase is already CLIPEXPORT_IDLE by the time this
+        // runs), and sets mainmenu=1 - genuinely landing back on the main menu, unlike a bare
+        // stopdemo() (which leaves the client sitting in the local demo server's own
+        // post-playback limbo, exactly the state the sgCancelExport/ESC path deliberately keeps
+        // for cancellation - see that alias's own comment). Checked before the idle early-return
+        // below, since by the time this flag is set, clipexportphase already IS idle. Guarded to
+        // fire exactly once per abort/finish (cleared immediately, before the call itself, in
+        // case localdisconnect() somehow re-entered this function).
+        if(clipexportpendingreturn)
+        {
+            clipexportpendingreturn = false;
+            localdisconnect(true);
+        }
+
+        if(clipexportphase == CLIPEXPORT_IDLE) return;
+
+        if(clipexportphase == CLIPEXPORT_WAITING)
+        {
+            if(clipexporttargetcn < 0)
+            {
