     void startintermission() { gamelimit = min(gamelimit, gamemillis); checkintermission(true); }
 
+    // === INSTA RELOAD (tools/local-insta-server; not shipped in any bundle) ===
+    // A stock 2020 client gates its own rifle purely locally: fpsgame/weapon.cpp shoot() refuses
+    // until lastmillis - lastaction >= gunwait, and the only server message that touches those
+    // fields on player1 is N_SHOTFX, which fpsgame/client.cpp applies to ANY cn including the
+    // client's own (there is no d==player1 guard). So on a kill the server tells the killer's
+    // client it just fired instareloadgun: lastaction becomes now and gunwait that gun's
+    // attackdelay (fist 250ms instead of the rifle's 1500ms), and gunselect flips to it. An
+    // N_GUNSELECT wrapped in N_CLIENT with the killer's OWN cn (the one way the server can address
+    // player1 through a client-originated message) puts the rifle back in the same packet, so no
+    // frame ever renders the fx gun. What the player notices: the fx gun's shot sound (fist = a
+    // ~300ms chainsaw rev with chainsawhudgun 1, the default; a punch whoosh with 0) plus the
+    // weapon-load click. The server half mirrors that: the wait becomes the fx gun's delay, which
+    // a stock client cannot beat, so a cheating client gets no better fire rate than an honest one.
+    void instareloadkiller(clientinfo *actor)
+    {
+        gamestate &gs = actor->state;
+        if(gs.state!=CS_ALIVE || gs.aitype!=AI_NONE) return;
+        int fxgun = instareloadgun==2 ? GUN_CG : GUN_FIST; // only these two make sense: see the cvar
+        gs.gunwait = guns[fxgun].attackdelay;
+        vec o = gs.o.x > -1e9f ? gs.o : vec(0, 0, 0);
+        ivec fx(vec(o.x, o.y, o.z - 4096).mul(DMF)); // far below the map: the chaingun option's sparks/decal land out of sight
+        packetbuf p(MAXTRANS, ENET_PACKET_FLAG_RELIABLE);
+        putint(p, N_SHOTFX); putint(p, actor->clientnum); putint(p, fxgun); putint(p, 0);
+        putint(p, fx.x); putint(p, fx.y); putint(p, fx.z); putint(p, fx.x); putint(p, fx.y); putint(p, fx.z);
+        uchar gunsel[8];
+        ucharbuf q(gunsel, sizeof(gunsel));
+        putint(q, N_GUNSELECT); putint(q, gs.gunselect);
+        putint(p, N_CLIENT); putint(p, actor->clientnum); putuint(p, q.length()); p.put(q.buf, q.length());
+        sendpacket(actor->clientnum, 1, p.finalize());
+    }
+
+    // "#instareload [on|off]" in chat, or "/servcmd instareload [on|off]" ("/instareload" itself
+    // never leaves a stock client: '/' runs a client-side command). No argument toggles. Anyone
+    // may toggle while no master/admin is on; once one is, only they may.
+    bool instareloadcommand(clientinfo *ci, clientinfo *cq, const char *cmd)
+    {
+        const char *s = cmd;
+        while(*s==' ') s++;
+        if(strncmp(s, "instareload", 11)) return false;
+        s += 11;
+        if(*s && *s!=' ') return false;
+        while(*s==' ') s++;
+        bool privileged = ci->local || ci->privilege>=PRIV_MASTER, hasmaster = false;
+        loopv(clients) if(clients[i]->local || clients[i]->privilege>=PRIV_MASTER) hasmaster = true;
+        if(hasmaster && !privileged)
+        {
+            sendf(ci->clientnum, 1, "ris", N_SERVMSG, "insta reload: only the master can toggle it while a master is on");
+            return true;
+        }
+        int val;
+        if(!*s) val = instareload ? 0 : 1;
+        else if(!strcmp(s, "on") || !strcmp(s, "1")) val = 1;
+        else if(!strcmp(s, "off") || !strcmp(s, "0")) val = 0;
+        else { sendf(ci->clientnum, 1, "ris", N_SERVMSG, "usage: #instareload [on|off]"); return true; }
+        instareload = val;
+        sendservmsgf("insta reload %s (%s): a kill %s the killer's rifle", val ? "\f0ON\f7" : "\f3OFF\f7", colorname(cq), val ? "now re-arms" : "no longer re-arms");
+        if(isdedicatedserver()) logoutf("insta reload %s by %s", val ? "on" : "off", colorname(cq));
+        return true;
+    }
